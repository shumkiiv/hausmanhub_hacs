{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shumkiiv/hausmanhub-contracts/schemas/v1/climate-runtime.schema.json",
  "title": "HausmanHub tablet climate runtime v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "generated_at",
    "state_revision",
    "phase",
    "authority",
    "fresh",
    "commands_enabled",
    "blocked_reasons",
    "home_control",
    "rooms",
    "active_operations"
  ],
  "properties": {
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "hausman-hub-climate-runtime"},
        "version": {"const": 1}
      }
    },
    "generated_at": {"type": "integer", "minimum": 0},
    "state_revision": {"type": "integer", "minimum": 0},
    "control_revision": {"type": "integer", "minimum": 0},
    "phase": {
      "enum": ["disabled", "shadow", "ready_for_canary", "canary", "managed", "unavailable"]
    },
    "authority": {"enum": ["legacy_climate_core", "hausman_hub", "none", "unknown"]},
    "fresh": {"type": "boolean"},
    "commands_enabled": {"type": "boolean"},
    "blocked_reasons": {
      "type": "array",
      "items": {"$ref": "#/$defs/block_reason"},
      "uniqueItems": true,
      "maxItems": 16
    },
    "home_control": {"$ref": "#/$defs/control"},
    "rooms": {
      "type": "array",
      "items": {"$ref": "#/$defs/room"},
      "maxItems": 128
    },
    "active_operations": {
      "type": "array",
      "items": {"$ref": "#/$defs/active_operation"},
      "maxItems": 64
    },
    "participation_summary": {"$ref": "#/$defs/participation_summary"}
  },
  "allOf": [
    {
      "if": {"properties": {"commands_enabled": {"const": true}}, "required": ["commands_enabled"]},
      "then": {
        "properties": {
          "phase": {"enum": ["canary", "managed"]},
          "authority": {"const": "hausman_hub"},
          "blocked_reasons": {"maxItems": 0}
        },
        "allOf": [
          {
            "if": {"properties": {"fresh": {"const": true}}, "required": ["fresh"]},
            "then": {
              "anyOf": [
                {
                  "properties": {
                    "home_control": {
                      "type": "object",
                      "required": ["enabled"],
                      "properties": {"enabled": {"const": true}}
                    }
                  }
                },
                {
                  "properties": {
                    "rooms": {"contains": {"$ref": "#/$defs/enabled_room"}, "minContains": 1}
                  }
                }
              ]
            },
            "else": {
              "properties": {
                "home_control": {"$ref": "#/$defs/disabled_control"},
                "rooms": {"contains": {"$ref": "#/$defs/manual_exclusion_room"}, "minContains": 1}
              }
            }
          }
        ]
      },
      "else": {
        "properties": {
          "home_control": {"$ref": "#/$defs/disabled_control"},
          "rooms": {"not": {"contains": {"$ref": "#/$defs/enabled_room"}}}
        }
      }
    },
    {
      "if": {"required": ["control_revision", "participation_summary"]},
      "then": {"properties": {
        "generated_at": {"maximum": 9007199254740991}, "state_revision": {"maximum": 9007199254740991}, "control_revision": {"maximum": 9007199254740991},
        "rooms": {"items": {"properties": {
          "control_revision": {"maximum": 9007199254740991}, "last_deviation_at": {"maximum": 9007199254740991}, "next_retry_at": {"maximum": 9007199254740991}, "escalated_at": {"maximum": 9007199254740991},
          "cooldown": {"properties": {"until": {"maximum": 9007199254740991}}},
          "devices": {"items": {"properties": {"control_revision": {"maximum": 9007199254740991}, "participation": {"properties": {"changed_at": {"maximum": 9007199254740991}}}}}}
        }}},
        "active_operations": {"items": {"properties": {"expected_control_revision": {"maximum": 9007199254740991}, "updated_at": {"maximum": 9007199254740991}}}}
      }}
    }
  ],
  "$defs": {
    "stable_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
    "temperature": {"type": ["number", "null"], "minimum": 5, "maximum": 40},
    "humidity": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "temperature_range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum", "step"],
      "properties": {
        "minimum": {"type": "number", "minimum": 5, "maximum": 40},
        "maximum": {"type": "number", "minimum": 5, "maximum": 40},
        "step": {"type": "number", "exclusiveMinimum": 0, "maximum": 5}
      }
    },
    "humidity_range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum", "step"],
      "properties": {
        "minimum": {"type": "integer", "minimum": 0, "maximum": 100},
        "maximum": {"type": "integer", "minimum": 0, "maximum": 100},
        "step": {"type": "integer", "minimum": 1, "maximum": 20}
      }
    },
    "temporary_override": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active", "target_temperature", "ends_at"],
      "properties": {
        "active": {"type": "boolean"},
        "target_temperature": {"$ref": "#/$defs/temperature"},
        "ends_at": {"type": ["string", "null"], "format": "date-time"}
      },
      "allOf": [
        {
          "if": {"properties": {"active": {"const": true}}, "required": ["active"]},
          "then": {"properties": {"target_temperature": {"type": "number"}}},
          "else": {
            "properties": {
              "target_temperature": {"type": "null"},
              "ends_at": {"type": "null"}
            }
          }
        }
      ]
    },
    "action": {
      "enum": [
        "set_home_targets",
        "synchronize_home",
        "set_room_target",
        "clear_room_override",
        "set_room_mode",
        "set_device_mode",
        "set_room_humidity_target",
        "set_room_min_target",
        "set_room_target_strategy",
        "turn_room_off"
      ]
    },
    "block_reason": {
      "enum": [
        "climate_disabled",
        "shadow_only",
        "state_stale",
        "authority_not_ready",
        "room_not_in_canary",
        "registry_mismatch",
        "cooldown_active",
        "operation_pending",
        "action_unsupported",
        "device_unavailable"
      ]
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "allowed_actions", "blocked_reasons"],
      "properties": {
        "enabled": {"type": "boolean"},
        "allowed_actions": {
          "type": "array",
          "items": {"$ref": "#/$defs/action"},
          "uniqueItems": true,
          "maxItems": 9
        },
        "blocked_reasons": {
          "type": "array",
          "items": {"$ref": "#/$defs/block_reason"},
          "uniqueItems": true,
          "maxItems": 16
        }
      },
      "allOf": [
        {
          "if": {"properties": {"enabled": {"const": true}}, "required": ["enabled"]},
          "then": {
            "properties": {
              "allowed_actions": {"minItems": 1},
              "blocked_reasons": {"maxItems": 0}
            }
          },
          "else": {
            "properties": {
              "allowed_actions": {"maxItems": 0},
              "blocked_reasons": {"minItems": 1}
            }
          }
        }
      ]
    },
    "disabled_control": {
      "allOf": [
        {"$ref": "#/$defs/control"},
        {"properties": {"enabled": {"const": false}, "allowed_actions": {"maxItems": 0}}}
      ]
    },
    "cooldown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active", "remaining_seconds", "reason"],
      "properties": {
        "active": {"type": "boolean"},
        "remaining_seconds": {"type": "integer", "minimum": 0, "maximum": 86400},
        "reason": {"enum": ["none", "minimum_runtime", "minimum_idle", "rate_limit"]}
      },
      "allOf": [
        {
          "if": {"properties": {"active": {"const": true}}, "required": ["active"]},
          "then": {
            "properties": {
              "remaining_seconds": {"minimum": 1},
              "reason": {"not": {"const": "none"}}
            }
          },
          "else": {
            "properties": {"remaining_seconds": {"const": 0}, "reason": {"const": "none"}}
          }
        }
      ]
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "control_scope", "available", "state", "cooldown", "last_confirmed_operation"],
      "properties": {
        "id": {"$ref": "#/$defs/stable_id"},
        "name": {"type": "string", "minLength": 1, "maxLength": 120},
        "kind": {"enum": ["air_conditioner", "radiator_thermostat", "humidifier", "floor_heating", "temperature_sensor", "humidity_sensor"]},
        "control_scope": {"enum": ["observed", "canary", "managed"]},
        "available": {"type": "boolean"},
        "state": {"enum": ["working", "idle", "off", "unavailable", "unknown"]},
        "target_temperature": {"$ref": "#/$defs/temperature"},
        "target_humidity": {"$ref": "#/$defs/humidity"},
        "desired_target_temperature": {"$ref": "#/$defs/temperature"},
        "reported_target_temperature": {"anyOf": [{"$ref": "#/$defs/temperature"}, {"type": "null"}]},
        "desired_target_humidity": {"$ref": "#/$defs/humidity"},
        "reported_target_humidity": {"anyOf": [{"$ref": "#/$defs/humidity"}, {"type": "null"}]},
        "mode": {"enum": ["automatic", "manual", "unknown"]},
        "mode_name": {
          "enum": ["Автоматический режим", "Ручной режим", "Режим неизвестен"]
        },
        "control_revision": {"type": "integer", "minimum": 0},
        "participation": {"$ref": "#/$defs/participation"},
        "control": {"$ref": "#/$defs/control"},
        "cooldown": {"oneOf": [{"$ref": "#/$defs/cooldown"}, {"type": "null"}]},
        "last_confirmed_operation": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["operation_id", "action", "updated_at"],
              "properties": {
                "operation_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
                "action": {"$ref": "#/$defs/action"},
                "updated_at": {"type": "integer", "minimum": 0}
              }
            },
            {"type": "null"}
          ]
        },
        "deviation_guard": {"$ref": "#/$defs/deviation_guard"}
      },
      "allOf": [
        {"if": {"required": ["control_revision"]}, "then": {"required": ["target_temperature", "target_humidity", "desired_target_temperature", "desired_target_humidity", "reported_target_temperature", "reported_target_humidity"]}},
        {"if": {"required": ["participation"]}, "then": {"required": ["mode", "mode_name"]}},
        {"if": {"required": ["participation"], "properties": {"participation": {"properties": {"mode": {"const": "manual"}}}}}, "then": {"properties": {"mode": {"const": "manual"}, "mode_name": {"const": "Ручной режим"}}}},
        {"if": {"properties": {"mode": {"const": "manual"}}, "required": ["mode"]}, "then": {"properties": {"mode_name": {"const": "Ручной режим"}, "participation": {"properties": {"mode": {"const": "manual"}}}}}},
        {"if": {"required": ["participation"], "properties": {"participation": {"properties": {"mode": {"const": "automatic"}}}}}, "then": {"properties": {"mode": {"const": "automatic"}, "mode_name": {"const": "Автоматический режим"}}}},
        {"if": {"properties": {"mode": {"const": "automatic"}}, "required": ["mode"]}, "then": {"properties": {"mode_name": {"const": "Автоматический режим"}, "participation": {"properties": {"mode": {"const": "automatic"}}}}}},
        {"if": {"properties": {"mode": {"const": "unknown"}}, "required": ["mode"]}, "then": {"properties": {"mode_name": {"const": "Режим неизвестен"}}}},
        {"if": {"required": ["participation"], "properties": {"participation": {"properties": {"connectivity": {"const": "available"}}}}}, "then": {"required": ["mode", "mode_name"], "properties": {"available": {"const": true}}}},
        {"if": {"required": ["participation"], "properties": {"participation": {"properties": {"connectivity": {"const": "unavailable"}}}}}, "then": {"properties": {"available": {"const": false}, "state": {"const": "unavailable"}}}},
        {"if": {"properties": {"available": {"const": true}}, "required": ["available"]}, "then": {"properties": {"participation": {"properties": {"connectivity": {"const": "available"}}}}}},
        {"if": {"properties": {"state": {"const": "unavailable"}}, "required": ["state"]}, "then": {"properties": {"available": {"const": false}, "participation": {"properties": {"connectivity": {"const": "unavailable"}}}}}},
        {"if": {"required": ["participation"], "properties": {"participation": {"properties": {"connectivity": {"const": "stale"}}}}}, "then": {"required": ["mode", "mode_name"], "properties": {"available": {"const": false}, "state": {"const": "unknown"}}}},
        {"if": {"required": ["participation"], "properties": {"participation": {"properties": {"reason": {"const": "device_unavailable"}}}}}, "then": {"properties": {"participation": {"properties": {"connectivity": {"const": "unavailable"}, "synchronization": {"const": "deferred"}}}, "available": {"const": false}, "state": {"const": "unavailable"}}}},
        {"if": {"required": ["participation"], "properties": {"participation": {"properties": {"reason": {"const": "state_stale"}}}}}, "then": {"properties": {"participation": {"properties": {"connectivity": {"const": "stale"}, "synchronization": {"const": "deferred"}}}, "available": {"const": false}, "state": {"const": "unknown"}}}},
        {"if": {"required": ["participation"], "properties": {"participation": {"properties": {"connectivity": {"const": "available"}}}}}, "then": {"properties": {"participation": {"properties": {"reason": {"not": {"enum": ["device_unavailable", "state_stale"]}}}}}}}
      ]
    },
    "deviation_guard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "status",
        "expected_state",
        "observed_state",
        "retry_count",
        "max_retries",
        "last_deviation_at",
        "next_retry_at",
        "escalated_at"
      ],
      "properties": {
        "mode": {"enum": ["monitor", "enforce"]},
        "status": {"enum": ["armed", "grace", "observed", "cooldown", "retrying", "escalated"]},
        "expected_state": {"const": "off"},
        "observed_state": {"enum": ["off", "working", "idle", "unavailable", "unknown"]},
        "retry_count": {"type": "integer", "minimum": 0, "maximum": 5},
        "max_retries": {"type": "integer", "minimum": 1, "maximum": 5},
        "last_deviation_at": {"type": ["integer", "null"], "minimum": 0},
        "next_retry_at": {"type": ["integer", "null"], "minimum": 0},
        "escalated_at": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "room": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "temperature",
        "humidity",
        "target_temperature",
        "target_humidity",
        "minimum_temperature",
        "temperature_range",
        "humidity_range",
        "mode",
        "target_strategy",
        "active_profile",
        "temporary_override",
        "authority",
        "control",
        "devices"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/stable_id"},
        "name": {"type": "string", "minLength": 1, "maxLength": 120},
        "temperature": {"$ref": "#/$defs/temperature"},
        "humidity": {"$ref": "#/$defs/humidity"},
        "target_temperature": {"$ref": "#/$defs/temperature"},
        "target_humidity": {"$ref": "#/$defs/humidity"},
        "desired_target_temperature": {"$ref": "#/$defs/temperature"},
        "reported_target_temperature": {"anyOf": [{"$ref": "#/$defs/temperature"}, {"type": "null"}]},
        "desired_target_humidity": {"$ref": "#/$defs/humidity"},
        "reported_target_humidity": {"anyOf": [{"$ref": "#/$defs/humidity"}, {"type": "null"}]},
        "control_revision": {"type": "integer", "minimum": 0},
        "minimum_temperature": {"$ref": "#/$defs/temperature"},
        "temperature_range": {"$ref": "#/$defs/temperature_range"},
        "humidity_range": {"$ref": "#/$defs/humidity_range"},
        "mode": {"enum": ["automatic", "manual", "off", "unknown"]},
        "target_strategy": {"enum": ["soft", "normal", "aggressive", "unknown"]},
        "active_profile": {"enum": ["day", "night", null]},
        "temporary_override": {"$ref": "#/$defs/temporary_override"},
        "authority": {"enum": ["legacy_climate_core", "hausman_hub", "none", "unknown"]},
        "control": {"$ref": "#/$defs/control"},
        "devices": {"type": "array", "items": {"$ref": "#/$defs/device"}, "maxItems": 32},
        "recovery_preflight": {"type": "object", "additionalProperties": false, "required": ["room_id", "control_revision", "desired_snapshot_fingerprint", "resolved_device_ids", "snapshot_token"], "properties": {"room_id": {"$ref": "#/$defs/stable_id"}, "control_revision": {"type": "integer", "minimum": 0}, "desired_snapshot_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "resolved_device_ids": {"type": "array", "items": {"$ref": "#/$defs/stable_id"}, "minItems": 1, "maxItems": 32, "uniqueItems": true}, "snapshot_token": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{15,127}$"}}}
      },
      "allOf": [
        {"if": {"required": ["control_revision"]}, "then": {"required": ["desired_target_temperature", "reported_target_temperature", "desired_target_humidity", "reported_target_humidity"]}},
        {"if": {"properties": {"devices": {"contains": {"type": "object", "properties": {"participation": {"type": "object", "properties": {"mode": {"const": "manual"}, "recovery": {"const": "return_to_contour"}}, "required": ["mode", "recovery"]}}, "required": ["participation"]}}}, "required": ["devices"]}, "then": {"required": ["recovery_preflight"]}}
      ]
    },
    "enabled_room": {
      "type": "object",
      "required": ["authority", "control"],
      "properties": {
        "authority": {"const": "hausman_hub"},
        "control": {
          "type": "object",
          "required": ["enabled", "allowed_actions"],
          "properties": {"enabled": {"const": true}, "allowed_actions": {"minItems": 1}}
        }
      }
    },
    "manual_exclusion_room": {
      "type": "object",
      "required": ["authority", "control"],
      "properties": {
        "authority": {"const": "hausman_hub"},
        "control": {
          "type": "object",
          "required": ["enabled", "allowed_actions"],
          "properties": {
            "enabled": {"const": true},
            "allowed_actions": {
              "type": "array",
              "contains": {"const": "set_room_mode"},
              "minContains": 1
            }
          }
        }
      }
    },
    "participation_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["automatic_count", "excluded_count", "unavailable_count", "pending_sync_count"],
      "properties": {
        "automatic_count": {"type": "integer", "minimum": 0, "maximum": 4096},
        "excluded_count": {"type": "integer", "minimum": 0, "maximum": 4096},
        "unavailable_count": {"type": "integer", "minimum": 0, "maximum": 4096},
        "pending_sync_count": {"type": "integer", "minimum": 0, "maximum": 4096}
      }
    },
    "participation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "connectivity", "synchronization", "reason", "changed_at", "message_code", "message", "recovery"],
      "properties": {
        "mode": {"enum": ["automatic", "manual"]},
        "connectivity": {"enum": ["available", "unavailable", "stale"]},
        "synchronization": {"enum": ["in_sync", "pending", "deferred", "diverged", "failed"]},
        "reason": {"enum": ["none", "pending_dispatch", "user_excluded", "external_off", "device_unavailable", "state_stale", "command_failed", "configuration_error"]},
        "changed_at": {"type": ["integer", "null"], "minimum": 0},
        "message_code": {"enum": ["in_sync", "pending_dispatch", "manual_excluded", "external_off", "device_unavailable", "state_stale", "command_failed", "configuration_error"]},
        "message": {"type": "string", "minLength": 1, "maxLength": 500},
        "recovery": {"enum": ["none", "return_to_contour", "wait_for_connection", "check_configuration"]}
      },
      "allOf": [
        {"if": {"properties": {"mode": {"const": "manual"}}, "required": ["mode"]}, "then": {"properties": {"reason": {"enum": ["user_excluded", "external_off"]}, "recovery": {"const": "return_to_contour"}}}},
        {"if": {"properties": {"mode": {"const": "automatic"}}, "required": ["mode"]}, "then": {"properties": {"reason": {"not": {"enum": ["user_excluded", "external_off"]}}}}},
        {"if": {"properties": {"reason": {"const": "user_excluded"}}, "required": ["reason"]}, "then": {"properties": {"mode": {"const": "manual"}, "recovery": {"const": "return_to_contour"}, "message_code": {"const": "manual_excluded"}}}},
        {"if": {"properties": {"reason": {"const": "external_off"}}, "required": ["reason"]}, "then": {"properties": {"mode": {"const": "manual"}, "recovery": {"const": "return_to_contour"}, "message_code": {"const": "external_off"}}}},
        {"if": {"properties": {"mode": {"const": "automatic"}, "connectivity": {"const": "unavailable"}}, "required": ["mode", "connectivity"]}, "then": {"properties": {"reason": {"const": "device_unavailable"}, "synchronization": {"const": "deferred"}, "recovery": {"const": "wait_for_connection"}, "message_code": {"const": "device_unavailable"}}}},
        {"if": {"properties": {"mode": {"const": "automatic"}, "connectivity": {"const": "stale"}}, "required": ["mode", "connectivity"]}, "then": {"properties": {"reason": {"const": "state_stale"}, "synchronization": {"const": "deferred"}, "recovery": {"const": "wait_for_connection"}, "message_code": {"const": "state_stale"}}}},
        {"if": {"properties": {"mode": {"const": "automatic"}, "connectivity": {"const": "available"}, "synchronization": {"const": "pending"}}, "required": ["mode", "connectivity", "synchronization"]}, "then": {"properties": {"reason": {"const": "pending_dispatch"}, "recovery": {"const": "none"}, "message_code": {"const": "pending_dispatch"}}}},
        {"if": {"properties": {"reason": {"const": "command_failed"}}, "required": ["reason"]}, "then": {"properties": {"mode": {"const": "automatic"}, "synchronization": {"enum": ["failed", "diverged"]}, "recovery": {"const": "check_configuration"}, "message_code": {"const": "command_failed"}}}},
        {"if": {"properties": {"reason": {"const": "configuration_error"}}, "required": ["reason"]}, "then": {"properties": {"mode": {"const": "automatic"}, "synchronization": {"enum": ["failed", "diverged"]}, "recovery": {"const": "check_configuration"}, "message_code": {"const": "configuration_error"}}}},
        {"if": {"properties": {"synchronization": {"const": "in_sync"}}, "required": ["synchronization"]}, "then": {"properties": {"reason": {"const": "none"}, "recovery": {"const": "none"}, "message_code": {"const": "in_sync"}}}},
        {"if": {"properties": {"reason": {"const": "none"}}, "required": ["reason"]}, "then": {"properties": {"mode": {"const": "automatic"}, "connectivity": {"const": "available"}, "synchronization": {"const": "in_sync"}, "recovery": {"const": "none"}, "message_code": {"const": "in_sync"}}}}
      ]
    },
    "active_operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "request_id", "action", "room_id", "status", "updated_at"],
      "properties": {
        "operation_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
        "request_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"},
        "request_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "action": {"$ref": "#/$defs/action"},
        "room_id": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
        "expected_control_revision": {"type": "integer", "minimum": 0},

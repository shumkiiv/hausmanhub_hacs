        {"required": ["status", "reason", "execution_state", "message_code", "message"], "properties": {"status": {"const": "pending"}, "reason": {"const": "none"}, "execution_state": {"const": "pending_dispatch"}, "message_code": {"const": "pending"}, "message": {"const": "Команда принята и ожидает отправки."}}},

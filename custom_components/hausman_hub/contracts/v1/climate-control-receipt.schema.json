    "device_observation": {"type": "object", "additionalProperties": false, "required": ["desired_target_temperature", "desired_target_humidity", "reported_target_temperature", "reported_target_humidity", "observed_at", "fresh"], "properties": {"desired_target_temperature": {"type": ["number", "null"], "minimum": 18, "maximum": 28, "multipleOf": 0.5}, "desired_target_humidity": {"type": ["integer", "null"], "minimum": 30, "maximum": 70}, "reported_target_temperature": {"type": ["number", "null"], "minimum": 5, "maximum": 40}, "reported_target_humidity": {"type": ["integer", "null"], "minimum": 0, "maximum": 100}, "observed_at": {"type": "integer", "minimum": 0}, "fresh": {"const": true}, "observed_actual": {"$ref": "#/$defs/desired_device"}, "action": {"type": "object", "additionalProperties": false, "required": ["request_fingerprint", "action", "parameters"], "properties": {"request_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "action": {"enum": ["apply_saved_settings", "apply_schedule_profile", "set_temporary_temperature", "return_to_schedule"]}, "parameters": {"type": "object", "additionalProperties": false, "properties": {"contour_id": {"const": "climate"}, "confirm": {"type": "boolean"}, "room_ids": {"type": "array", "items": {"$ref": "#/$defs/stable_id"}}, "schedule_profile": {"enum": ["day", "night"]}, "profile_id": {"type": "string"}, "room_id": {"$ref": "#/$defs/stable_id"}, "target_temperature": {"type": ["number", "null"]}, "action": {"enum": ["set", "clear"]}}}}}}},

        {"required": ["status", "reason", "message_code", "message"], "not": {"required": ["execution_state"]}, "properties": {"status": {"const": "deferred"}, "reason": {"enum": ["device_unavailable", "state_stale"]}, "message_code": {"const": "deferred_offline"}, "message": {"const": "Цель сохранена и будет применена после восстановления связи."}}},
        {"required": ["status", "reason", "execution_state", "retry_policy", "message_code", "message"], "properties": {"status": {"const": "failed"}, "reason": {"const": "command_failed"}, "execution_state": {"const": "dispatched_not_accepted"}, "retry_policy": {"const": "forbidden_after_dispatch"}, "command_count": {"const": 1}, "accepted_count": {"const": 0}, "message_code": {"const": "command_failed"}, "message": {"const": "Команда не подтверждена, требуется проверка устройства."}}},
        {"required": ["status", "reason", "execution_state", "message_code", "message", "command_count", "accepted_count"], "properties": {"status": {"const": "not_attempted"}, "reason": {"const": "configuration_error"}, "execution_state": {"const": "blocked_before_dispatch"}, "command_count": {"const": 0}, "accepted_count": {"const": 0}, "message_code": {"const": "configuration_error"}, "message": {"const": "Конфигурация устройства требует проверки."}}},

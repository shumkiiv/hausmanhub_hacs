        {"required": ["status", "reason", "execution_state", "message_code", "message"], "properties": {"status": {"const": "not_attempted"}, "reason": {"const": "room_not_in_canary"}, "execution_state": {"const": "blocked_before_dispatch"}, "message_code": {"const": "room_not_in_canary"}, "message": {"const": "Помещение не входит в текущую группу управления."}}}

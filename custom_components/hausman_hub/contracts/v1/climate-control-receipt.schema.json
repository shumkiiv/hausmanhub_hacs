        {"if": {"properties": {"status": {"not": {"const": "superseded_by_newer_intent"}}}, "required": ["status"]}, "then": {"not": {"anyOf": [{"required": ["superseded_by_operation_id"]}, {"required": ["superseded_by_request_fingerprint"]}]}}}

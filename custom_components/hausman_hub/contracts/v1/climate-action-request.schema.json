{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shumkiiv/hausmanhub-contracts/schemas/v1/climate-action-request.schema.json",
  "title": "HausmanHub tablet climate action request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "request_id", "expected_state_revision", "action", "room_id", "parameters"],
  "properties": {
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "hausman-hub-climate-action-request"},
        "version": {"const": 1}
      }
    },
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"},
    "expected_state_revision": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "action": {
      "enum": [
        "set_home_targets",
        "synchronize_home",
        "set_room_target",
        "clear_room_override",
        "set_room_mode",
        "set_device_mode",
        "set_room_humidity_target",
        "set_room_min_target",
        "set_room_target_strategy",
        "turn_room_off"
      ]
    },
    "room_id": {
      "type": ["string", "null"],
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "parameters": {"type": "object"}
  },
  "allOf": [
    {"if": {"properties": {"action": {"const": "set_home_targets"}}, "required": ["action"]}, "then": {"properties": {"room_id": {"const": null}, "parameters": {"$ref": "#/$defs/home_targets"}}}},
    {"if": {"properties": {"action": {"const": "synchronize_home"}}, "required": ["action"]}, "then": {"properties": {"room_id": {"const": null}, "parameters": {"$ref": "#/$defs/empty"}}}},
    {"if": {"properties": {"action": {"const": "set_room_target"}}, "required": ["action"]}, "then": {"properties": {"room_id": {"$ref": "#/$defs/room_id"}, "parameters": {"$ref": "#/$defs/room_target"}}}},
    {"if": {"properties": {"action": {"const": "clear_room_override"}}, "required": ["action"]}, "then": {"properties": {"room_id": {"$ref": "#/$defs/room_id"}, "parameters": {"$ref": "#/$defs/empty"}}}},
    {"if": {"properties": {"action": {"const": "set_room_mode"}}, "required": ["action"]}, "then": {"properties": {"room_id": {"$ref": "#/$defs/room_id"}, "parameters": {"$ref": "#/$defs/room_mode"}}}},
    {"if": {"properties": {"action": {"const": "set_device_mode"}}, "required": ["action"]}, "then": {"properties": {"room_id": {"$ref": "#/$defs/room_id"}, "parameters": {"$ref": "#/$defs/device_mode"}}}},
    {"if": {"properties": {"action": {"const": "set_room_humidity_target"}}, "required": ["action"]}, "then": {"properties": {"room_id": {"$ref": "#/$defs/room_id"}, "parameters": {"$ref": "#/$defs/humidity_target"}}}},
    {"if": {"properties": {"action": {"const": "set_room_min_target"}}, "required": ["action"]}, "then": {"properties": {"room_id": {"$ref": "#/$defs/room_id"}, "parameters": {"$ref": "#/$defs/min_target"}}}},
    {"if": {"properties": {"action": {"const": "set_room_target_strategy"}}, "required": ["action"]}, "then": {"properties": {"room_id": {"$ref": "#/$defs/room_id"}, "parameters": {"$ref": "#/$defs/target_strategy"}}}},
    {"if": {"properties": {"action": {"const": "turn_room_off"}}, "required": ["action"]}, "then": {"properties": {"room_id": {"$ref": "#/$defs/room_id"}, "parameters": {"$ref": "#/$defs/empty"}}}}
  ],
  "$defs": {
    "room_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
    "temperature": {"type": "number", "minimum": 18, "maximum": 28, "multipleOf": 0.5},
    "empty": {"type": "object", "additionalProperties": false, "maxProperties": 0},
    "home_targets": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "target_temperature": {"$ref": "#/$defs/temperature"},
        "target_humidity": {"type": "integer", "minimum": 30, "maximum": 70}
      }
    },
    "room_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_temperature"],
      "properties": {"target_temperature": {"$ref": "#/$defs/temperature"}}
    },
    "room_mode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {"mode": {"enum": ["automatic", "manual"]}}
    },
    "device_mode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device_id", "mode"],
      "properties": {
        "device_id": {"$ref": "#/$defs/room_id"},
        "mode": {"enum": ["automatic", "manual"]}
      }
    },
    "humidity_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_humidity"],
      "properties": {"target_humidity": {"type": "integer", "minimum": 30, "maximum": 70}}
    },
    "min_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_temperature"],
      "properties": {"minimum_temperature": {"$ref": "#/$defs/temperature"}}
    },
    "target_strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_strategy"],
      "properties": {"target_strategy": {"enum": ["soft", "normal", "aggressive"]}}
    }
  }
}

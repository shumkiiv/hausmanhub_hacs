{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shumkiiv/hausmanhub-contracts/schemas/v1/scenario-dry-run-result.schema.json",
  "title": "HausmanHub safe scenario dry-run result v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["valid", "action_count", "referenced_scenario_ids", "plan", "report"],
  "properties": {
    "valid": {"const": true},
    "action_count": {"type": "integer", "minimum": 1, "maximum": 64},
    "referenced_scenario_ids": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/stableId"}
    },
    "plan": {"type": ["object", "null"]},
    "report": {"$ref": "#/$defs/report"}
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract", "status", "summary", "conditionCount", "actionCount",
        "commandSent", "conditions", "steps"
      ],
      "properties": {
        "contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": {"const": "hausman-hub-scenario-dry-run"},
            "version": {"const": 1}
          }
        },
        "status": {"enum": ["completed", "skipped", "failed"]},
        "summary": {"type": "string", "minLength": 1, "maxLength": 500},
        "conditionCount": {"type": "integer", "minimum": 0, "maximum": 32},
        "actionCount": {"type": "integer", "minimum": 1, "maximum": 64},
        "commandSent": {"const": false},
        "conditions": {
          "type": "array",
          "maxItems": 32,
          "items": {"$ref": "#/$defs/condition"}
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {"$ref": "#/$defs/step"}
        }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "title", "status"],
      "properties": {
        "position": {"type": "integer", "minimum": 1, "maximum": 32},
        "title": {"type": "string", "minLength": 1, "maxLength": 240},
        "status": {"enum": ["passed", "failed"]},
        "reason": {"type": ["string", "null"], "maxLength": 500}
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "type", "title", "status"],
      "properties": {
        "position": {"type": "integer", "minimum": 1, "maximum": 64},
        "type": {"enum": ["device_action", "delay", "run_scenario", "notification", "existing_action"]},
        "title": {"type": "string", "minLength": 1, "maxLength": 240},
        "targetName": {"type": ["string", "null"], "maxLength": 240},
        "roomName": {"type": ["string", "null"], "maxLength": 120},
        "valueLabel": {"type": ["string", "null"], "maxLength": 120},
        "status": {"enum": ["planned", "skipped", "failed"]},
        "reason": {"type": ["string", "null"], "maxLength": 500}
      }
    }
  }
}

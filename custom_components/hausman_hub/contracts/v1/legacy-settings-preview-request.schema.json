{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hausman.local/hausmanhub/contracts/v1/legacy-settings-preview-request.schema.json",
  "title": "HausmanHub legacy settings preview request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "globals"],
  "properties": {
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "hausman-hub-legacy-settings-export"},
        "version": {"const": 1}
      }
    },
    "globals": {
      "type": "object",
      "maxProperties": 128,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "additionalProperties": true
    }
  }
}

    "climate_reliability_v1": {
      "availabilitySemantics": {
        "available": "true only when the runtime is ready to produce the negotiated reliability branch",
        "producer_guarantees_full_branch": "must equal available; false when the producer is unavailable or not fully initialized",
        "activation": "the full branch applies only when the capability is advertised with available=true and producer_guarantees_full_branch=true; a retained available=false object does not activate it"
      },
      "operations": [
        {
          "method": "GET",
          "path": "/api/hausman_hub/v1/climate/runtime"
        },
        {
          "method": "GET",
          "path": "/api/hausman_hub/v1/climate/operations/{operation_id}"

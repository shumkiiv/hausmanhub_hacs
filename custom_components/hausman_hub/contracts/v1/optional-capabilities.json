    "climate_room_recovery_v1": {
      "availabilitySemantics": {
        "available": "false for physical POST; retained only for read-only terminal legacy polling",
        "v1Polling": "GET may return only a final terminal v1 receipt; unfinished proofless work uses the API typed unavailable/error behavior without redispatch"
      },
      "operations": [
        {
          "method": "POST",
          "path": "/api/hausman_hub/v1/climate/recovery/rooms/{room_id}"

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shumkiiv/hausmanhub-contracts/schemas/v1/scenario-catalog.schema.json",
  "title": "HausmanHub scenario editor catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["devices"],
  "properties": {
    "devices": {
      "type": "array",
      "maxItems": 1024,
      "items": {"$ref": "#/$defs/device"}
    },
    "scenarios": {
      "type": "array",
      "maxItems": 512,
      "items": {"$ref": "#/$defs/scenario"}
    }
  },
  "$defs": {
    "stable_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_id", "name", "entity_id", "actions"],
      "properties": {
        "target_id": {"$ref": "#/$defs/stable_id"},
        "name": {"type": "string", "minLength": 1, "maxLength": 240},
        "entity_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*\\.[a-z0-9_]+$"
        },
        "physical_id": {"$ref": "#/$defs/stable_id"},
        "physical_name": {"type": "string", "minLength": 1, "maxLength": 240},
        "room_id": {"$ref": "#/$defs/stable_id"},
        "room_name": {"type": "string", "minLength": 1, "maxLength": 120},
        "device_type": {"$ref": "#/$defs/stable_id"},
        "device_type_name": {"type": "string", "minLength": 1, "maxLength": 120},
        "capability_name": {"type": "string", "minLength": 1, "maxLength": 160},
        "properties": {
          "type": "array",
          "maxItems": 32,
          "items": {"$ref": "#/$defs/property"}
        },
        "actions": {
          "type": "array",
          "maxItems": 32,
          "items": {"$ref": "#/$defs/action"}
        }
      }
    },
    "property": {
      "type": "object",
      "additionalProperties": false,
      "required": ["property_id", "label", "value_type", "comparisons"],
      "properties": {
        "property_id": {"$ref": "#/$defs/stable_id"},
        "label": {"type": "string", "minLength": 1, "maxLength": 120},
        "value_type": {"enum": ["enum", "number", "text", "boolean"]},
        "unit": {"type": "string", "minLength": 1, "maxLength": 32},
        "source": {"const": "home_assistant_capability"},
        "availability_policy": {"const": "exclude_unknown_unavailable"},
        "comparisons": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {"enum": ["equals", "not_equals", "above", "below", "changed"]}
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {"$ref": "#/$defs/property_option"}
        }
      }
    },
    "property_option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "label"],
      "properties": {
        "value": {"type": ["string", "number", "boolean"]},
        "label": {"type": "string", "minLength": 1, "maxLength": 120}
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_id", "title", "domain", "service", "allowed_fields"],
      "properties": {
        "action_id": {"$ref": "#/$defs/stable_id"},
        "title": {"type": "string", "minLength": 1, "maxLength": 120},
        "domain": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "service": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "allowed_fields": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 16,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
        },
        "value_policy": {"$ref": "#/$defs/value_policy"}
      }
    },
    "value_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "preview"],
      "properties": {
        "kind": {"enum": ["percent", "kelvin", "rgb_hex"]},
        "minimum": {"type": "number"},
        "maximum": {"type": "number"},
        "step": {"type": "number", "exclusiveMinimum": 0},
        "unit": {"type": "string", "minLength": 1, "maxLength": 16},
        "default": {"type": ["string", "number"]},
        "presets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"type": ["string", "number"]}
        },
        "preview": {"type": "boolean"}
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": {"$ref": "#/$defs/stable_id"},
        "title": {"type": "string", "minLength": 1, "maxLength": 120},
        "icon": {
          "type": "string",
          "pattern": "^mdi:[a-z0-9-]+$",
          "maxLength": 80
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hausmanhub.local/contracts/v1/operation-journal.schema.json",
  "title": "HausmanHub operation journal",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "generated_at", "sequence", "records"],
  "properties": {
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "hausman-hub-operation-journal"},
        "version": {"const": 1}
      }
    },
    "generated_at": {"type": "integer", "minimum": 0},
    "sequence": {"type": "integer", "minimum": 0},
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order",
        "limit",
        "returned",
        "has_more",
        "next_before_sequence",
        "retained_records",
        "retention_limit"
      ],
      "properties": {
        "order": {"const": "sequence_desc"},
        "limit": {"type": "integer", "minimum": 1, "maximum": 512},
        "returned": {"type": "integer", "minimum": 0, "maximum": 512},
        "has_more": {"type": "boolean"},
        "next_before_sequence": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "retained_records": {"type": "integer", "minimum": 0, "maximum": 512},
        "retention_limit": {"const": 512}
      },
      "allOf": [
        {
          "if": {"properties": {"has_more": {"const": true}}},
          "then": {
            "properties": {
              "next_before_sequence": {"type": "integer", "minimum": 1}
            }
          }
        },
        {
          "if": {"properties": {"has_more": {"const": false}}},
          "then": {"properties": {"next_before_sequence": {"const": null}}}
        }
      ]
    },
    "records": {
      "type": "array",
      "maxItems": 512,
      "items": {"$ref": "#/$defs/record"}
    }
  },
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "correlation_id",
        "source",
        "operation",
        "accepted",
        "confirmed",
        "status",
        "occurred_at",
        "reason",
        "error_code"
      ],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1},
        "correlation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "source": {
          "enum": ["device", "climate", "scenario", "voice"]
        },
        "operation": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{0,63}$"
        },
        "accepted": {"type": "boolean"},
        "confirmed": {"type": "boolean"},
        "status": {"enum": ["accepted", "confirmed", "failed"]},
        "occurred_at": {"type": "integer", "minimum": 0},
        "reason": {
          "type": ["string", "null"],
          "maxLength": 512
        },
        "error_code": {
          "type": ["string", "null"],
          "maxLength": 128
        },
        "scenario": {"$ref": "#/$defs/scenario_run"},
        "manualOffProtection": {
          "type": "object", "additionalProperties": false,
          "required": ["roomId", "profileId", "state", "reason"],
          "properties": {
            "roomId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
            "profileId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
            "state": {"enum": ["active", "ready_to_release", "released", "cancelled_by_manual_on"]},
            "reason": {"enum": ["manual_off", "manual_off_protection_active"]}
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "confirmed"}}},
          "then": {
            "properties": {
              "accepted": {"const": true},
              "confirmed": {"const": true}
            }
          }
        },
        {
          "if": {"properties": {"confirmed": {"const": true}}},
          "then": {"properties": {"status": {"const": "confirmed"}}}
        },
        {
          "if": {"required": ["scenario"]},
          "then": {
            "properties": {
              "source": {"const": "scenario"},
              "operation": {"const": "scenario_run"}
            }
          }
        },
        {
          "if": {
            "properties": {
              "scenario": {
                "properties": {"command_mode": {"const": "shadow"}},
                "required": ["command_mode"]
              }
            },
            "required": ["scenario"]
          },
          "then": {
            "properties": {
              "confirmed": {"const": false}
            }
          }
        }
      ]
    },
    "scenario_run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "run_id",
        "execution_mode",
        "outcome",
        "evidence_revision",
        "decisions",
        "actions"
      ],
      "properties": {
        "scenario_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
        "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
        "execution_mode": {"enum": ["single", "restart", "queued"]},
        "command_mode": {
          "description": "Whether this run could call services or only evaluated the plan",
          "enum": ["live", "shadow"]
        },
        "trigger": {"$ref": "#/$defs/scenario_trigger"},
        "outcome": {"enum": ["completed", "skipped", "cancelled", "partial", "failed"]},
        "evidence_revision": {"type": ["string", "null"], "maxLength": 128},
        "decisions": {
          "type": "array",
          "maxItems": 64,
          "items": {"$ref": "#/$defs/scenario_decision"}
        },
        "actions": {
          "type": "array",
          "maxItems": 64,
          "items": {"$ref": "#/$defs/scenario_action"}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"command_mode": {"const": "shadow"}},
            "required": ["command_mode"]
          },
          "then": {
            "properties": {
              "actions": {
                "items": {
                  "properties": {"confirmed": {"const": null}}
                }
              }
            }
          }
        }
      ]
    },
    "scenario_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "outcome", "reason"],
      "properties": {
        "rule_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
        "outcome": {"enum": ["passed", "skipped", "failed"]},
        "reason": {"type": ["string", "null"], "maxLength": 256}
      }
    },
    "scenario_trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "trigger_id", "recovery"],
      "properties": {
        "source": {"enum": ["manual", "schedule", "device_state", "custom_event", "nested"]},
        "trigger_id": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
        "target_id": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
        "old_value": {"type": ["string", "number", "boolean", "null"]},
        "new_value": {"type": ["string", "number", "boolean", "null"]},
        "recovery": {"type": "boolean"}
      }
    },
    "scenario_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_id", "outcome", "confirmed", "reason"],
      "properties": {
        "action_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
        "target_id": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
        "outcome": {"enum": ["completed", "skipped", "failed"]},
        "confirmed": {"type": ["boolean", "null"]},
        "reason": {"type": ["string", "null"], "maxLength": 256}
      }
    }
  }
}

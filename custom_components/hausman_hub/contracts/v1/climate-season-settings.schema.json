{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shumkiiv/hausmanhub-contracts/schemas/v1/climate-season-settings.schema.json",
  "title": "HausmanHub interseason climate settings v1",
  "description": "Interseason (off-season) cooling restraint: when outdoor temperature is low enough, air conditioners stay off instead of maintaining the room at target and start only above a configurable indoor gap.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "enabled",
    "outdoorMaxTemperatureC",
    "coolingStartGap",
    "windowOpenOff",
    "dateStart",
    "dateEnd"
  ],
  "properties": {
    "enabled": { "type": "boolean" },
    "outdoorMaxTemperatureC": {
      "type": "number",
      "minimum": 5,
      "maximum": 35,
      "multipleOf": 0.5
    },
    "coolingStartGap": {
      "type": "number",
      "minimum": 1,
      "maximum": 4,
      "multipleOf": 0.1
    },
    "windowOpenOff": { "type": "boolean" },
    "dateStart": {
      "type": ["string", "null"],
      "pattern": "^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    },
    "dateEnd": {
      "type": ["string", "null"],
      "pattern": "^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    }
  }
}

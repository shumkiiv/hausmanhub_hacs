{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shumkiiv/hausmanhub-contracts/schemas/v1/scenario-upcoming-cancel-receipt.schema.json",
  "title": "HausmanHub scenario upcoming cancel receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["cancelled", "scenarioId", "triggerId", "runAt"],
  "properties": {
    "cancelled": { "type": "boolean" },
    "scenarioId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "triggerId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "runAt": { "type": "string", "format": "date-time" }
  }
}

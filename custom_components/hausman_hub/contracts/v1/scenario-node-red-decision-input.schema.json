{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/shumkiiv/hausmanhub-contracts/schemas/v1/scenario-node-red-decision-input.schema.json",
  "title":"HausmanHub Node-RED decision input v1","type":"object","additionalProperties":false,
  "required":["contract","correlationId","scenarioId","controllerVersion","settingsRevision","snapshotRevision","observationEpoch","issuedAtMs","expiresAtMs","event","clock","bindings","settings","observations","authority","durable","receipts"],
  "$defs":{
    "id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},"safe":{"type":"integer","minimum":0,"maximum":9007199254740991},
    "clock":{"type":"string","pattern":"^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"},
    "target":{"type":"object","additionalProperties":false,"required":["state","revision","observedAtMs","fresh","continuityEpoch"],"properties":{"state":{"enum":["on","off","unknown","unavailable"]},"revision":{"$ref":"#/$defs/safe"},"observedAtMs":{"$ref":"#/$defs/safe"},"fresh":{"type":"boolean"},"continuityEpoch":{"$ref":"#/$defs/safe"},"brightnessPercent":{"type":"integer","minimum":0,"maximum":100},"colorTemperatureKelvin":{"type":"integer","minimum":1500,"maximum":10000}}},
    "authority":{"type":"object","additionalProperties":false,"required":["owner","generation","protectionActive"],"properties":{"owner":{"enum":["none","automatic","manual","uncertain"]},"generation":{"$ref":"#/$defs/safe"},"protectionActive":{"type":"boolean"},"confirmedReceiptId":{"$ref":"#/$defs/id"},"confirmedStateRevision":{"$ref":"#/$defs/safe"},"lastManualAtMs":{"$ref":"#/$defs/safe"},"protectedUntilMs":{"$ref":"#/$defs/safe"},"manualOnHoldUntilMs":{"$ref":"#/$defs/safe"}}},
    "wakeup":{"type":"object","additionalProperties":false,"required":["id","kind","dueAtMs"],"properties":{"id":{"$ref":"#/$defs/id"},"kind":{"enum":["profile","absence","fade","mirror","hold"]},"dueAtMs":{"$ref":"#/$defs/safe"}}}
  },
  "properties":{
    "contract":{"type":"object","additionalProperties":false,"required":["name","version"],"properties":{"name":{"const":"hausman-node-red-decision-input"},"version":{"const":1}}},"correlationId":{"$ref":"#/$defs/id"},"scenarioId":{"type":"string","pattern":"^[a-z][a-z0-9_-]{0,63}$"},"controllerVersion":{"const":1},"settingsRevision":{"$ref":"#/$defs/safe"},"snapshotRevision":{"$ref":"#/$defs/safe"},"observationEpoch":{"$ref":"#/$defs/safe"},"issuedAtMs":{"$ref":"#/$defs/safe"},"expiresAtMs":{"$ref":"#/$defs/safe"},
    "event":{"type":"object","additionalProperties":false,"required":["id","kind","observedAtMs"],"properties":{"id":{"$ref":"#/$defs/id"},"kind":{"enum":["sensor","clock","arrival","receipt","wakeup","recovery","settings","manual"]},"observedAtMs":{"$ref":"#/$defs/safe"},"targetId":{"$ref":"#/$defs/id"},"wakeupId":{"$ref":"#/$defs/id"},"receiptId":{"$ref":"#/$defs/id"}}},
    "clock":{"type":"object","additionalProperties":false,"required":["nowMs","timezone","localDate","minutesOfDay","sunsetAtMs"],"properties":{"nowMs":{"$ref":"#/$defs/safe"},"timezone":{"type":"string","minLength":1,"maxLength":80},"localDate":{"type":"string","format":"date"},"minutesOfDay":{"type":"integer","minimum":0,"maximum":1439},"sunsetAtMs":{"type":["integer","null"],"minimum":0,"maximum":9007199254740991},"sunriseAtMs":{"type":["integer","null"],"minimum":0,"maximum":9007199254740991}}},
    "bindings":{"type":"object","additionalProperties":false,"required":["chandelier","points","mirror","power","presenceSensors"],"properties":{"chandelier":{"$ref":"#/$defs/id"},"points":{"$ref":"#/$defs/id"},"mirror":{"$ref":"#/$defs/id"},"power":{"$ref":"#/$defs/id"},"presenceSensors":{"type":"array","minItems":1,"maxItems":3,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}}}},
    "settings":{"type":"object","additionalProperties":false,"required":["morningStart","morningEnd","eveningLatestStart","mainOff","mirrorOff","minPercent","maxPercent","dayKelvin","eveningKelvin","absenceDaySeconds","absenceNightSeconds","fadeSeconds","manualOffMinSeconds","manualOffAbsenceSeconds","manualOnHoldSeconds"],"properties":{"morningStart":{"$ref":"#/$defs/clock"},"morningEnd":{"$ref":"#/$defs/clock"},"eveningLatestStart":{"$ref":"#/$defs/clock"},"mainOff":{"$ref":"#/$defs/clock"},"mirrorOff":{"$ref":"#/$defs/clock"},"minPercent":{"type":"integer","minimum":0,"maximum":100},"maxPercent":{"type":"integer","minimum":0,"maximum":100},"dayKelvin":{"type":"integer","minimum":1500,"maximum":10000},"eveningKelvin":{"type":"integer","minimum":1500,"maximum":10000},"absenceDaySeconds":{"$ref":"#/$defs/safe"},"absenceNightSeconds":{"$ref":"#/$defs/safe"},"fadeSeconds":{"$ref":"#/$defs/safe"},"manualOffMinSeconds":{"$ref":"#/$defs/safe"},"manualOffAbsenceSeconds":{"$ref":"#/$defs/safe"},"manualOnHoldSeconds":{"$ref":"#/$defs/safe"}}},
    "observations":{"type":"object","maxProperties":8,"additionalProperties":{"$ref":"#/$defs/target"},"propertyNames":{"$ref":"#/$defs/id"}},"authority":{"type":"object","maxProperties":3,"additionalProperties":{"$ref":"#/$defs/authority"},"propertyNames":{"$ref":"#/$defs/id"}},
    "durable":{"type":"object","additionalProperties":false,"required":["revision","phase","phaseStartedAtMs","absenceSinceMs","absenceEpoch","fadeStartPercent","fadeStartedAtMs","fadeReason","pendingReceiptId","wakeups"],"properties":{"revision":{"$ref":"#/$defs/safe"},"phase":{"enum":["idle","occupied","absent","fade","mirror_handover","night","blocked"]},"phaseStartedAtMs":{"type":["integer","null"],"minimum":0,"maximum":9007199254740991},"absenceSinceMs":{"type":["integer","null"],"minimum":0,"maximum":9007199254740991},"absenceEpoch":{"type":["integer","null"],"minimum":0,"maximum":9007199254740991},"fadeStartPercent":{"type":["integer","null"],"minimum":0,"maximum":100},"fadeStartedAtMs":{"type":["integer","null"],"minimum":0,"maximum":9007199254740991},"fadeReason":{"enum":[null,"absence","night"]},"pendingReceiptId":{"type":["string","null"],"pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},"wakeups":{"type":"array","maxItems":4,"items":{"$ref":"#/$defs/wakeup"}}}},
    "receipts":{"type":"array","maxItems":4,"items":{"type":"object","additionalProperties":false,"required":["id","planId","actionId","targetId","status"],"properties":{"id":{"$ref":"#/$defs/id"},"planId":{"$ref":"#/$defs/id"},"actionId":{"enum":["turn_on","turn_off","set_brightness_percent","set_color_temperature"]},"targetId":{"$ref":"#/$defs/id"},"status":{"enum":["confirmed","failed","uncertain"]},"observedRevision":{"$ref":"#/$defs/safe"},"observedAtMs":{"$ref":"#/$defs/safe"}}}}
  }
}

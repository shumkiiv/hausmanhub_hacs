{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hausman.local/hausmanhub/contracts/v1/device-action-batch-receipt.schema.json",
  "title": "HausmanHub device action batch receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "correlationId",
    "status",
    "total",
    "acceptedCount",
    "confirmedCount",
    "failedCount",
    "receipts"
  ],
  "properties": {
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "hausman-hub-device-action-batch-receipt"},
        "version": {"const": 1}
      }
    },
    "correlationId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "status": {"enum": ["failed", "partial", "accepted", "confirmed"]},
    "total": {"type": "integer", "minimum": 1, "maximum": 64},
    "acceptedCount": {"type": "integer", "minimum": 0, "maximum": 64},
    "confirmedCount": {"type": "integer", "minimum": 0, "maximum": 64},
    "failedCount": {"type": "integer", "minimum": 0, "maximum": 64},
    "receipts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "device-action-receipt.schema.json"}
    }
  }
}

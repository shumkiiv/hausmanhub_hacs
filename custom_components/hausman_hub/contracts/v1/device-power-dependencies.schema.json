{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shumkiiv/hausmanhub-contracts/schemas/v1/device-power-dependencies.schema.json",
  "title": "HausmanHub device power dependencies v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "revision", "updatedAt", "dependencies"],
  "properties": {
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "hausman-hub-device-power-dependencies" },
        "version": { "const": 1 }
      }
    },
    "revision": { "type": "integer", "minimum": 0 },
    "updatedAt": { "type": "string", "format": "date-time" },
    "dependencies": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/dependency" }
    }
  },
  "$defs": {
    "entityId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*\\.[a-z0-9_]+$",
      "maxLength": 255
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dependentEntityId", "powerSourceEntityId", "policy"],
      "properties": {
        "dependentEntityId": { "$ref": "#/$defs/entityId" },
        "powerSourceEntityId": { "$ref": "#/$defs/entityId" },
        "policy": { "const": "requires_on" }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hausman.local/hausmanhub/contracts/v1/device-action-receipt.schema.json",
  "title": "HausmanHub device action receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "requestId",
    "accepted",
    "confirmed",
    "status",
    "targetId",
    "actionId"
  ],
  "properties": {
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "hausman-hub-device-action-receipt" },
        "version": { "const": 1 }
      }
    },
    "requestId": { "type": "string", "minLength": 1 },
    "accepted": { "type": "boolean" },
    "confirmed": { "type": "boolean" },
    "status": { "enum": ["failed", "accepted", "confirmed"] },
    "statusName": {
      "enum": ["Не выполнено", "Проверяется", "Выполнено"]
    },
    "targetId": { "type": "string", "minLength": 1 },
    "actionId": { "type": "string", "minLength": 1 },
    "observedState": { "type": ["string", "null"] },
    "appliedAt": { "type": ["integer", "null"] },
    "message": { "type": ["string", "null"], "maxLength": 500 },
    "confirmationWindowMs": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 30000
    },
    "readBack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempted", "matched", "observedAt"],
      "properties": {
        "attempted": { "type": "boolean" },
        "matched": { "type": "boolean" },
        "observedAt": { "type": ["integer", "null"], "minimum": 0 },
        "observedState": { "type": ["string", "null"] },
        "attempts": { "type": "integer", "minimum": 0, "maximum": 128 }
      }
    },
    "reason": { "type": ["string", "null"] },
    "error": { "type": ["string", "null"] }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "confirmed" } } },
      "then": {
        "properties": {
          "accepted": { "const": true },
          "confirmed": { "const": true },
          "statusName": { "const": "Выполнено" }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "accepted" } } },
      "then": {
        "properties": {
          "accepted": { "const": true },
          "confirmed": { "const": false },
          "statusName": { "const": "Проверяется" }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "failed" } } },
      "then": {
        "properties": {
          "confirmed": { "const": false },
          "statusName": { "const": "Не выполнено" }
        }
      }
    }
  ]
}

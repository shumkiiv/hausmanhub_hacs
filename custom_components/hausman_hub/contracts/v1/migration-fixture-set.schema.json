{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hausmanhub.local/schemas/v1/migration-fixture-set.schema.json",
  "title": "HausmanHub N-2 migration fixture set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "apiMajorVersion",
    "supportWindow",
    "currentLine",
    "fixturePaths",
    "fixtureViews",
    "androidConsumers",
    "hacsProducers"
  ],
  "properties": {
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "hausman-hub-n-minus-two-migration-fixtures"},
        "version": {"const": 1}
      }
    },
    "apiMajorVersion": {"const": 1},
    "supportWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["previousVersionsPerComponent", "policy"],
      "properties": {
        "previousVersionsPerComponent": {"const": 2},
        "policy": {"const": "current_plus_two_previous_releases"}
      }
    },
    "currentLine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contracts", "android", "hacs"],
      "properties": {
        "contracts": {"$ref": "#/$defs/release"},
        "android": {"$ref": "#/$defs/androidRelease"},
        "hacs": {"$ref": "#/$defs/release"}
      }
    },
    "fixturePaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/canonicalFixturePath"}
    },
    "fixtureViews": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/fixtureView"}
    },
    "androidConsumers": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/androidMigrationRelease"}
    },
    "hacsProducers": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/migrationRelease"}
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "semanticVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "releaseRef", "commit"],
      "properties": {
        "version": {"$ref": "#/$defs/semanticVersion"},
        "releaseRef": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "commit": {"$ref": "#/$defs/commit"}
      }
    },
    "androidRelease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "build", "releaseRef", "commit"],
      "properties": {
        "version": {"$ref": "#/$defs/semanticVersion"},
        "build": {"type": "integer", "minimum": 1},
        "releaseRef": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "commit": {"$ref": "#/$defs/commit"}
      }
    },
    "canonicalFixturePath": {
      "type": "string",
      "pattern": "^fixtures/v1/[a-z0-9-]+\\.json$"
    },
    "snapshotFixturePath": {
      "type": "string",
      "pattern": "^fixtures/migration/v1/contracts-[0-9]+\\.[0-9]+\\.[0-9]+/[a-z0-9-]+\\.json$"
    },
    "fixtureView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "contracts", "documents", "overrides"],
      "properties": {
        "id": {"type": "string", "pattern": "^contracts-[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "contracts": {"$ref": "#/$defs/release"},
        "documents": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"$ref": "#/$defs/canonicalFixturePath"},
          "additionalProperties": {"$ref": "#/$defs/sha256"}
        },
        "overrides": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/canonicalFixturePath"},
          "additionalProperties": {"$ref": "#/$defs/snapshotFixturePath"}
        }
      }
    },
    "migrationRelease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "releaseRef", "commit", "contracts", "fixtureViewId"],
      "properties": {
        "version": {"$ref": "#/$defs/semanticVersion"},
        "releaseRef": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "commit": {"$ref": "#/$defs/commit"},
        "contracts": {"$ref": "#/$defs/release"},
        "fixtureViewId": {"type": "string", "pattern": "^contracts-[0-9]+\\.[0-9]+\\.[0-9]+$"}
      }
    },
    "androidMigrationRelease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "build", "releaseRef", "commit", "contracts", "fixtureViewId"],
      "properties": {
        "version": {"$ref": "#/$defs/semanticVersion"},
        "build": {"type": "integer", "minimum": 1},
        "releaseRef": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "commit": {"$ref": "#/$defs/commit"},
        "contracts": {"$ref": "#/$defs/release"},
        "fixtureViewId": {"type": "string", "pattern": "^contracts-[0-9]+\\.[0-9]+\\.[0-9]+$"}
      }
    }
  }
}

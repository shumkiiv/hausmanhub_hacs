{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shumkiiv/hausmanhub-contracts/schemas/v1/climate-deviation-guard-document.schema.json",
  "title": "HausmanHub climate deviation guard document v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "revision", "updatedAt", "settings"],
  "properties": {
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "hausman-hub-climate-deviation-guard"},
        "version": {"const": 1}
      }
    },
    "revision": {"type": "integer", "minimum": 0},
    "updatedAt": {"type": "string", "format": "date-time"},
    "settings": {"$ref": "climate-deviation-guard-settings.schema.json"}
  }
}

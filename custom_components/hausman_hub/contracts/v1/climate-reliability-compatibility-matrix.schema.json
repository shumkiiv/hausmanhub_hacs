{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hausmanhub.local/schemas/v1/climate-reliability-compatibility-matrix.schema.json",
  "title": "HausmanHub climate reliability compatibility matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "currentReleasedClients",
    "fixturePaths",
    "fixtureViews",
    "hacsProducers",
    "androidConsumers",
    "ignoredOptionalSurfaces"
  ],
  "properties": {
    "contract": {
      "const": {
        "name": "hausman-hub-climate-reliability-compatibility",
        "version": 1
      }
    },
    "currentReleasedClients": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hacs",
        "android"
      ],
      "properties": {
        "hacs": {
          "$ref": "#/$defs/release"
        },
        "android": {
          "$ref": "#/$defs/androidRelease"
        }
      }
    },
    "fixturePaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/climateFixturePath"
      }
    },
    "fixtureViews": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/fixtureView"
      }
    },
    "hacsProducers": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/releaseConsumer"
      }
    },
    "androidConsumers": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/androidConsumer"
      }
    },
    "ignoredOptionalSurfaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/ignoredSurface"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "semanticVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "releaseRef",
        "commit"
      ],
      "properties": {
        "version": {
          "$ref": "#/$defs/semanticVersion"
        },
        "releaseRef": {
          "type": "string",
          "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "commit": {
          "$ref": "#/$defs/commit"
        }
      }
    },
    "androidRelease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "build",
        "releaseRef",
        "commit"
      ],
      "properties": {
        "version": {
          "$ref": "#/$defs/semanticVersion"
        },
        "build": {
          "type": "integer",
          "minimum": 1
        },
        "releaseRef": {
          "type": "string",
          "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "commit": {
          "$ref": "#/$defs/commit"
        }
      }
    },
    "climateFixturePath": {
      "type": "string",
      "pattern": "^fixtures/v1/(climate-(action-request|operation-(confirmed|pending|rejected)|runtime-[a-z0-9-]+)|climate-room-recovery-(request|receipt)-v2|climate-room-recovery-v2-preflight|contour-apply-receipt|temporary-temperature-receipt)\\.json$"
    },
    "snapshotFixturePath": {
      "type": "string",
      "pattern": "^fixtures/migration/v1/contracts-0\\.(62|63)\\.0/(climate-[a-z0-9-]+|climate-room-recovery-(request|receipt)-v2|climate-room-recovery-v2-preflight|contour-apply-receipt|temporary-temperature-receipt)\\.json$"
    },
    "fixtureView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "contracts",
        "documents",
        "overrides"
      ],
      "properties": {
        "id": {
          "enum": [
            "contracts-0.62.0",
            "contracts-0.63.0"
          ]
        },
        "contracts": {
          "$ref": "#/$defs/release"
        },
        "documents": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/climateFixturePath"
          },
          "additionalProperties": {
            "$ref": "#/$defs/sha256"
          }
        },
        "overrides": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/climateFixturePath"
          },
          "additionalProperties": {
            "$ref": "#/$defs/snapshotFixturePath"
          }
        }
      }
    },
    "releaseConsumer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "releaseRef",
        "commit",
        "contractsFixtureViewId"
      ],
      "properties": {
        "version": {
          "$ref": "#/$defs/semanticVersion"
        },
        "releaseRef": {
          "type": "string",
          "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "commit": {
          "$ref": "#/$defs/commit"
        },
        "contractsFixtureViewId": {
          "const": "contracts-0.63.0"
        }
      }
    },
    "androidConsumer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "build",
        "releaseRef",
        "commit",
        "contractsVersion",
        "fixtureAvailability",
        "compatibilityBoundary"
      ],
      "properties": {
        "version": {
          "$ref": "#/$defs/semanticVersion"
        },
        "build": {
          "type": "integer",
          "minimum": 1
        },
        "releaseRef": {
          "type": "string",
          "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "commit": {
          "$ref": "#/$defs/commit"
        },
        "contractsVersion": {
          "const": "0.60.0"
        },
        "fixtureAvailability": {
          "const": "unavailable"
        },
        "compatibilityBoundary": {
          "const": "fixed_climate_action_enum"
        },
        "unavailableReason": {
          "const": "exact_v0.60.0_climate_fixture_bundle_not_available"
        }
      }
    },
    "ignoredSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "method",
        "schemas",
        "capability",
        "status",
        "reason"
      ],
      "properties": {
        "path": {
          "enum": [
            "/api/hausman_hub/v1/climate/recovery/rooms/{room_id}",
            "/api/hausman_hub/v1/climate/recovery/operations/{operation_id}",
            "/api/hausman_hub/v1/climate/recovery/rooms/{room_id}/preflight"
          ]
        },
        "method": {
          "enum": [
            "POST",
            "GET"
          ]
        },
        "schemas": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "enum": [
              "schemas/v1/climate-room-recovery-request-v2.schema.json",
              "schemas/v1/climate-room-recovery-receipt-v2.schema.json",
              "schemas/v1/climate-room-recovery-v2-preflight.schema.json"
            ]
          }
        },
        "capability": {
          "const": "climate_room_recovery_v2"
        },
        "status": {
          "const": "ignored_optional_surface"
        },
        "reason": {
          "const": "introduced_after_historical_climate_action_enum"
        }
      },
      "oneOf": [
        {
          "properties": {
            "path": {
              "const": "/api/hausman_hub/v1/climate/recovery/rooms/{room_id}"
            },
            "method": {
              "const": "POST"
            },
            "schemas": {
              "const": [
                "schemas/v1/climate-room-recovery-request-v2.schema.json",
                "schemas/v1/climate-room-recovery-receipt-v2.schema.json"
              ]
            }
          }
        },
        {
          "properties": {
            "path": {"const": "/api/hausman_hub/v1/climate/recovery/rooms/{room_id}/preflight"},
            "method": {"const": "GET"},
            "schemas": {"const": ["schemas/v1/climate-room-recovery-v2-preflight.schema.json"]}
          }
        },
        {
          "properties": {
            "path": {
              "const": "/api/hausman_hub/v1/climate/recovery/operations/{operation_id}"
            },
            "method": {
              "const": "GET"
            },
            "schemas": {
              "const": [
                "schemas/v1/climate-room-recovery-receipt-v2.schema.json"
              ]
            }
          }
        }
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shumkiiv/hausmanhub-contracts/schemas/v1/room-power-migration-claim-request.schema.json",
  "title": "HausmanHub room power migration claim request v1",
  "description": "Local-admin request that names only a logical room and logical light target ids for an exact power-topology claim. It never accepts Home Assistant entity ids and never sends physical commands.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "roomId",
    "targetIds",
    "expectedRoomConfigVersion",
    "expectedDependencyRevision",
    "expectedClaimRevision"
  ],
  "properties": {
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "hausman-hub-room-power-migration-claim-request"},
        "version": {"const": 1}
      }
    },
    "roomId": {"$ref": "#/$defs/stable_id"},
    "targetIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/stable_id"},
      "description": "Logical room-lighting target ids selected by the administrator. The server persists only targets that currently have a matching power dependency; independent targets are reported as independent and are not stored in the claim."
    },
    "expectedRoomConfigVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "expectedDependencyRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expectedClaimRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "$defs": {
    "stable_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"}
  }
}

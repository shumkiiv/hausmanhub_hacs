{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shumkiiv/hausmanhub-contracts/schemas/v1/energy-settings-document.schema.json",
  "title": "HausmanHub persisted energy settings v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "revision", "updatedAt", "settings"],
  "properties": {
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "hausman-hub-energy-settings" },
        "version": { "const": 1 }
      }
    },
    "revision": { "type": "integer", "minimum": 0 },
    "updatedAt": { "type": "string", "format": "date-time" },
    "settings": { "$ref": "#/$defs/settings" }
  },
  "$defs": {
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "displayUnits",
        "showVoltage",
        "aggregation",
        "useAllDevices",
        "selectedDeviceIds"
      ],
      "properties": {
        "displayUnits": { "enum": ["watts", "amps", "both"] },
        "showVoltage": { "type": "boolean" },
        "aggregation": { "enum": ["combined", "separate"] },
        "useAllDevices": { "type": "boolean" },
        "selectedDeviceIds": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^device_[0-9a-f]{16}$" }
        },
        "anomalyPowerThresholdW": {
          "type": ["number", "null"],
          "minimum": 100,
          "maximum": 1000000
        },
        "anomalySustainMinutes": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 1440
        }
      },
      "allOf": [
        {
          "if": { "properties": { "anomalyPowerThresholdW": { "type": "number" } }, "required": ["anomalyPowerThresholdW"] },
          "then": { "properties": { "anomalySustainMinutes": { "type": "integer" } }, "required": ["anomalySustainMinutes"] }
        },
        {
          "if": { "properties": { "anomalySustainMinutes": { "type": "integer" } }, "required": ["anomalySustainMinutes"] },
          "then": { "properties": { "anomalyPowerThresholdW": { "type": "number" } }, "required": ["anomalyPowerThresholdW"] }
        }
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shumkiiv/hausmanhub-contracts/schemas/v1/scenario-node-red-execution.schema.json",
  "title": "HausmanHub Node-RED scenario execution trace v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "correlationId", "scenarioId", "status", "summary", "trace", "actions"],
  "properties": {
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "hausman-node-red-scenario-execution"},
        "version": {"const": 1}
      }
    },
    "correlationId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "scenarioId": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
    "status": {"enum": ["completed", "skipped", "failed"]},
    "summary": {"type": "string", "minLength": 1, "maxLength": 500},
    "selectedBranch": {"type": ["string", "null"], "maxLength": 120},
    "durationMs": {"type": "integer", "minimum": 0, "maximum": 10000},
    "trace": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
          "title": {"type": "string", "minLength": 1, "maxLength": 240},
          "status": {"enum": ["passed", "failed", "selected", "skipped"]},
          "actual": {"type": ["string", "number", "boolean", "null"]},
          "expected": {"type": ["string", "number", "boolean", "null"]},
          "reason": {"type": ["string", "null"], "maxLength": 500}
        }
      }
    },
    "actions": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "allOf": [
          {"$ref": "scenario-definition.schema.json#/$defs/action"},
          {"properties": {"type": {"enum": ["device_action", "delay", "run_scenario", "notification"]}}}
        ]
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hausman.local/hausmanhub/contracts/v1/manual-light-off-protection.schema.json",
  "title": "HausmanHub manual light off protection v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "revision", "updatedAt", "settings", "protections"],
  "properties": {
    "contract": {"type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": {"name": {"const": "hausman-hub-manual-light-off-protection"}, "version": {"const": 1}}},
    "revision": {"type": "integer", "minimum": 0},
    "updatedAt": {"type": "string", "format": "date-time"},
    "settings": {"$ref": "#/$defs/settings"},
    "protections": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/protection"}}
  },
  "$defs": {
    "roomId": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
    "profileId": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
    "entityId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "documentContract": {"type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": {"name": {"const": "hausman-hub-manual-light-off-protection"}, "version": {"const": 1}}},
    "policy": {"type": "object", "additionalProperties": false, "required": ["enabled", "minimumIntervalSeconds", "releaseMode", "stableAbsenceSeconds", "extendOnRepeatedManualOff", "noSensorFallback", "protectedScope", "allowManualRelease"], "properties": {"enabled": {"type": "boolean"}, "minimumIntervalSeconds": {"type": "integer", "minimum": 30, "maximum": 86400}, "releaseMode": {"enum": ["timer_and_absence", "timer_only", "absence_only"]}, "stableAbsenceSeconds": {"type": "integer", "minimum": 5, "maximum": 600}, "extendOnRepeatedManualOff": {"type": "boolean"}, "noSensorFallback": {"enum": ["timer_only", "manual_release"]}, "protectedScope": {"enum": ["source", "profile"]}, "allowManualRelease": {"type": "boolean"}}},
    "policyOverride": {"type": "object", "additionalProperties": false, "minProperties": 1, "properties": {"enabled": {"type": "boolean"}, "minimumIntervalSeconds": {"type": "integer", "minimum": 30, "maximum": 86400}, "releaseMode": {"enum": ["timer_and_absence", "timer_only", "absence_only"]}, "stableAbsenceSeconds": {"type": "integer", "minimum": 5, "maximum": 600}, "extendOnRepeatedManualOff": {"type": "boolean"}, "noSensorFallback": {"enum": ["timer_only", "manual_release"]}, "protectedScope": {"enum": ["source", "profile"]}, "allowManualRelease": {"type": "boolean"}}},
    "settings": {"type": "object", "additionalProperties": false, "required": ["globalPolicy", "roomOverrides", "profileOverrides", "profiles"], "properties": {"globalPolicy": {"$ref": "#/$defs/policy"}, "roomOverrides": {"type": "object", "additionalProperties": false, "patternProperties": {"^[a-z][a-z0-9_-]{0,63}$": {"$ref": "#/$defs/policyOverride"}}, "maxProperties": 64}, "profileOverrides": {"type": "object", "additionalProperties": false, "patternProperties": {"^[a-z][a-z0-9_-]{0,63}$": {"$ref": "#/$defs/policyOverride"}}, "maxProperties": 64}, "profiles": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/profile"}}}},
    "profile": {"type": "object", "additionalProperties": false, "required": ["roomId", "profileId", "lightIds", "presenceSensorIds"], "properties": {"roomId": {"$ref": "#/$defs/roomId"}, "profileId": {"$ref": "#/$defs/profileId"}, "lightIds": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/entityId"}}, "presenceSensorIds": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/entityId"}}}},
    "protection": {"type": "object", "additionalProperties": false, "required": ["roomId", "profileId", "lightIds", "startedAt", "notBefore", "absenceSince", "effectivePolicy", "effectivePolicySource", "policyFingerprint", "reason", "attributionSource", "attributionId", "revision", "state"], "properties": {"roomId": {"$ref": "#/$defs/roomId"}, "profileId": {"$ref": "#/$defs/profileId"}, "lightIds": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/entityId"}}, "startedAt": {"type": "string", "format": "date-time"}, "notBefore": {"type": "string", "format": "date-time"}, "absenceSince": {"type": ["string", "null"], "format": "date-time"}, "effectivePolicy": {"$ref": "#/$defs/policy"}, "effectivePolicySource": {"enum": ["global", "room", "profile"]}, "policyFingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "reason": {"const": "manual_off"}, "attributionSource": {"enum": ["manual_command", "state_transition"]}, "attributionId": {"$ref": "#/$defs/entityId"}, "revision": {"type": "integer", "minimum": 0}, "state": {"enum": ["active", "ready_to_release", "released", "cancelled_by_manual_on"]}}}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shumkiiv/hausmanhub_hacs/contracts/v1/climate-registry.schema.json",
  "title": "HausmanHub private climate registry, contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "home", "rooms", "devices"],
  "properties": {
    "version": {"const": 3},
    "home": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outdoor_temperature_entity_id", "presence_entity_id", "central_heating_entity_id"],
      "properties": {
        "outdoor_temperature_entity_id": {"$ref": "#/$defs/optional_entity_id"},
        "outdoor_temperature_entity_ids": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(sensor|weather)\\.[a-z0-9_]+$"
          }
        },
        "presence_entity_id": {"$ref": "#/$defs/optional_entity_id"},
        "central_heating_entity_id": {"$ref": "#/$defs/optional_entity_id"},
        "heating_lockout_high": {"type": "number", "minimum": -40, "maximum": 60},
        "heating_lockout_low": {"type": "number", "minimum": -40, "maximum": 60},
        "air_conditioner_minimum_outdoor_temperature": {"type": "number", "minimum": -40, "maximum": 60},
        "central_heating_temperature_on": {"type": "number", "minimum": -40, "maximum": 120},
        "central_heating_temperature_off": {"type": "number", "minimum": -40, "maximum": 120}
      }
    },
    "rooms": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "window_entity_id"],
        "properties": {
          "id": {"$ref": "#/$defs/stable_id"},
          "name": {"$ref": "#/$defs/name"},
          "window_entity_id": {"$ref": "#/$defs/optional_entity_id"},
          "presence_entity_ids": {
            "type": "array",
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^binary_sensor\\.[a-z0-9_]+$"
            }
          }
        }
      }
    },
    "devices": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "room_id", "kind", "source_id", "control_scope", "control_owner", "capabilities", "endpoints", "control_channel"],
        "properties": {
          "id": {"$ref": "#/$defs/stable_id"},
          "name": {"$ref": "#/$defs/name"},
          "room_id": {"$ref": "#/$defs/stable_id"},
          "kind": {"enum": ["air_conditioner", "radiator_thermostat", "humidifier", "floor_heating", "temperature_sensor", "humidity_sensor"]},
          "source_id": {"type": "string", "minLength": 1, "maxLength": 255},
          "control_scope": {"enum": ["observed", "canary", "managed"]},
          "control_owner": {"enum": ["climate_core", "manual", "observed"]},
          "capabilities": {
            "type": "array",
            "maxItems": 16,
            "uniqueItems": true,
            "items": {"enum": ["power", "target_temperature", "target_humidity", "hvac_mode", "fan_mode", "auto_manual", "target_strategy", "cooldown", "physical_feedback"]}
          },
          "endpoints": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["role", "entity_id"],
              "properties": {
                "role": {"enum": ["control", "temperature", "humidity", "physical_feedback", "fan", "valve_position", "child_lock", "water_level"]},
                "entity_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[a-z0-9_]+$"}
              }
            }
          },
          "control_channel": {
            "oneOf": [
              {"type": "null"},
              {"enum": ["universal_ir", "yandex_remote", "direct_wifi"]}
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "stable_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 120, "pattern": "^\\S(?:.*\\S)?$"},
    "optional_entity_id": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[a-z0-9_]+$"}
      ]
    }
  }
}

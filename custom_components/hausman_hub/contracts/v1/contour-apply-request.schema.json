{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hausman.local/hausmanhub/contracts/v1/contour-apply-request.schema.json",
  "title": "HausmanHub contour apply request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "contour_id", "confirm"],
  "properties": {
    "correlation_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
    },
    "contour_id": {"const": "climate"},
    "expected_control_revision": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "reliability_profile": {"const": "climate_reliability_v1"},
    "confirm": {"const": true},
    "schedule_profile": {"enum": ["day", "night"]},
    "room_ids": {
      "type": "array",
      "description": "Optional room scope. When present, only the listed configured rooms are applied; when absent, the whole contour is applied.",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{0,63}$"
      }
    }
  },
  "allOf": [
    {"if": {"required": ["reliability_profile"]}, "then": {"required": ["expected_control_revision"]}},
    {"if": {"required": ["schedule_profile"]}, "then": {"required": ["reliability_profile", "expected_control_revision"]}}
  ]
}

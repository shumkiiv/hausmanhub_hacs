{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shumkiiv/hausmanhub-contracts/schemas/v1/energy-history.schema.json",
  "title": "HausmanHub energy history v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "from", "to", "interval", "series"],
  "properties": {
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "hausman-hub-energy-history" },
        "version": { "const": 1 }
      }
    },
    "from": { "type": "string", "format": "date-time" },
    "to": { "type": "string", "format": "date-time" },
    "interval": { "enum": ["5m", "15m", "1h", "1d"] },
    "series": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "#/$defs/series" }
    }
  },
  "$defs": {
    "series": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "deviceId", "name", "unit", "points"],
      "properties": {
        "sourceId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "deviceId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "roomId": { "type": ["string", "null"], "maxLength": 128 },
        "unit": { "enum": ["W", "A", "V", "kWh"] },
        "metric": { "enum": ["power", "current", "voltage", "energy"] },
        "scope": { "enum": ["device", "selection"] },
        "aggregation": { "enum": ["mean", "sum", "delta"] },
        "points": {
          "type": "array",
          "maxItems": 8928,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["at", "value"],
            "properties": {
              "at": { "type": "string", "format": "date-time" },
              "value": { "type": ["number", "null"] }
            }
          }
        }
      }
    }
  }
}

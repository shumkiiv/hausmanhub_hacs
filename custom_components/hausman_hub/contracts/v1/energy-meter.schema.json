{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shumkiiv/hausmanhub-contracts/schemas/v1/energy-meter.schema.json",
  "title": "HausmanHub durable energy meter v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "revision", "updatedAt", "settings", "source", "reading",
    "cycle", "submission", "history"
  ],
  "properties": {
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "hausman-hub-energy-meter" },
        "version": { "const": 1 }
      }
    },
    "revision": { "type": "integer", "minimum": 0 },
    "updatedAt": { "type": "string", "format": "date-time" },
    "settings": { "$ref": "#/$defs/settings" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "currentTotalKwh", "state"],
      "properties": {
        "available": { "type": "boolean" },
        "currentTotalKwh": { "type": ["number", "null"], "minimum": 0 },
        "state": { "enum": ["available", "unavailable", "reset_detected"] }
      }
    },
    "reading": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currentKwh", "adjustedAt", "estimated"],
      "properties": {
        "currentKwh": { "type": ["number", "null"], "minimum": 0 },
        "adjustedAt": { "type": ["string", "null"], "format": "date-time" },
        "estimated": { "type": "boolean" }
      }
    },
    "cycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startedAt", "baselineReadingKwh", "consumptionKwh"],
      "properties": {
        "startedAt": { "type": ["string", "null"], "format": "date-time" },
        "baselineReadingKwh": { "type": ["number", "null"], "minimum": 0 },
        "consumptionKwh": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "submission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lastDate", "nextDate", "status", "daysUntil"],
      "properties": {
        "lastDate": { "type": ["string", "null"], "format": "date" },
        "nextDate": { "type": ["string", "null"], "format": "date" },
        "status": { "enum": ["disabled", "none", "upcoming", "due", "overdue"] },
        "daysUntil": { "type": ["integer", "null"], "minimum": -3660, "maximum": 3660 }
      }
    },
    "history": {
      "type": "array",
      "maxItems": 60,
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "$defs": {
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "submissionDayOfMonth", "reminderDaysBefore"],
      "properties": {
        "enabled": { "type": "boolean" },
        "submissionDayOfMonth": { "type": "integer", "minimum": 1, "maximum": 31 },
        "reminderDaysBefore": { "type": "integer", "minimum": 0, "maximum": 14 }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "readingKwh", "sourceTotalKwh", "recordedAt"],
      "properties": {
        "id": { "type": "string", "pattern": "^reading_[0-9]{1,10}$" },
        "kind": { "enum": ["submission", "correction"] },
        "readingKwh": { "type": "number", "minimum": 0 },
        "sourceTotalKwh": { "type": ["number", "null"], "minimum": 0 },
        "recordedAt": { "type": "string", "format": "date-time" }
      }
    },
    "actionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expectedRevision", "action"],
      "properties": {
        "expectedRevision": { "type": "integer", "minimum": 0 },
        "action": { "enum": ["configure", "submit", "correct"] },
        "settings": { "$ref": "#/$defs/settings" },
        "readingKwh": { "type": "number", "minimum": 0, "maximum": 1000000000 }
      },
      "allOf": [
        {
          "if": { "properties": { "action": { "const": "configure" } }, "required": ["action"] },
          "then": { "required": ["settings"], "not": { "required": ["readingKwh"] } }
        },
        {
          "if": { "properties": { "action": { "enum": ["submit", "correct"] } }, "required": ["action"] },
          "then": { "required": ["readingKwh"], "not": { "required": ["settings"] } }
        }
      ]
    }
  }
}

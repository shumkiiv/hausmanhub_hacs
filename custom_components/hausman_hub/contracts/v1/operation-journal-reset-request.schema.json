{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shumkiiv/hausmanhub-contracts/schemas/v1/operation-journal-reset-request.schema.json",
  "title": "HausmanHub operation journal reset request v1",
  "description": "Local administrator request that consumes one server-created archive token and atomically starts the next journal generation. Caller-supplied archive identifiers, digests and record counts are forbidden.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "archiveToken", "expectedGeneration", "expectedSequence", "expectedRevision"],
  "properties": {
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "hausman-hub-operation-journal-reset-request"},
        "version": {"const": 1}
      }
    },
    "correlationId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "archiveToken": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43,128}$", "description": "Opaque, single-use, expiry-limited token generated by the server from at least 256 bits of cryptographic randomness. It must not be logged."},
    "expectedGeneration": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "expectedSequence": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "expectedRevision": {"type": "string", "pattern": "^[a-f0-9]{16,64}$"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shumkiiv/hausmanhub-contracts/schemas/v1/dashboard-snapshot.schema.json",
  "title": "HausmanHub universal dashboard snapshot v1",
  "type": "object",
  "required": ["contract", "generatedAt", "summary", "rooms", "devices", "scenarios", "alarms", "events"],
  "properties": {
    "contract": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "universal-home" },
        "version": { "const": 1 },
        "profile": { "type": "string" },
        "source": { "type": "string" }
      },
      "additionalProperties": true
    },
    "generatedAt": { "type": "integer" },
    "stateRevision": { "type": ["integer", "null"] },
    "localIso": { "type": ["string", "null"] },
    "summary": {
      "type": "object",
      "properties": {
        "homeName": { "type": ["string", "null"] },
        "mode": { "type": ["string", "null"] },
        "targetTemp": { "type": ["number", "null"] },
        "avgTemp": { "type": ["number", "null"] },
        "outdoorTemp": { "type": ["number", "null"] },
        "weatherCondition": { "type": ["string", "null"] },
        "weatherHumidity": { "type": ["number", "null"] },
        "weatherFeelsLike": { "type": ["number", "null"] },
        "weatherWindSpeed": { "type": ["number", "null"] },
        "weatherWindSpeedUnit": { "type": ["string", "null"] },
        "weatherIsDay": { "type": ["boolean", "null"] },
        "weatherUpdatedAt": { "type": ["integer", "null"] },
        "co2": { "type": ["number", "null"] },
        "activeLights": { "type": "integer" },
        "activeClimate": { "type": "integer" },
        "activeAlarms": { "type": "integer" }
      },
      "additionalProperties": true
    },
    "comfort": { "$ref": "#/$defs/comfort" },
    "rooms": {
      "type": "array",
      "items": { "$ref": "#/$defs/room" }
    },
    "devices": {
      "type": "array",
      "items": { "$ref": "#/$defs/device" }
    },
    "energy": { "$ref": "#/$defs/energy" },
    "weather": { "$ref": "#/$defs/weather" },
    "inventory": {
      "$ref": "#/$defs/inventory"
    },
    "catalogReadiness": { "$ref": "#/$defs/catalogReadiness" },
    "adapterHealth": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/adapterHealth" }
    },
    "scenarios": {
      "type": "array",
      "items": { "$ref": "#/$defs/scenario" }
    },
    "alarms": {
      "type": "array",
      "items": { "$ref": "#/$defs/alarm" }
    },
    "events": {
      "type": "array",
      "items": { "$ref": "#/$defs/event" }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "raw": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "adapterHealth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "state", "budgetMs", "consecutiveFailures", "timeoutCount", "openCount", "recoveryCount"],
      "properties": {
        "adapter": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
        "state": { "enum": ["closed", "open", "half_open"] },
        "budgetMs": { "type": "integer", "minimum": 100, "maximum": 30000 },
        "consecutiveFailures": { "type": "integer", "minimum": 0 },
        "timeoutCount": { "type": "integer", "minimum": 0 },
        "openCount": { "type": "integer", "minimum": 0 },
        "recoveryCount": { "type": "integer", "minimum": 0 }
      }
    },
    "catalogReadiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "attempt", "maxAttempts", "deviceCount", "updatedAt", "reason"],
      "properties": {
        "status": { "enum": ["warming", "ready", "degraded"] },
        "attempt": { "type": "integer", "minimum": 0, "maximum": 4 },
        "maxAttempts": { "const": 4 },
        "deviceCount": { "type": "integer", "minimum": 0, "maximum": 4096 },
        "updatedAt": { "type": "integer", "minimum": 0 },
        "reason": { "enum": ["initial_scan", "warmup_complete", "warmup_failed"] }
      }
    },
    "comfort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "score", "statusLabel", "dataQuality"],
      "properties": {
        "available": { "type": "boolean" },
        "score": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
        "statusLabel": { "type": ["string", "null"], "minLength": 1, "maxLength": 48 },
        "dataQuality": { "enum": ["fresh", "stale", "limited"] }
      },
      "allOf": [
        {
          "if": {
            "properties": { "available": { "const": true } },
            "required": ["available"]
          },
          "then": {
            "properties": {
              "score": { "type": "integer" },
              "statusLabel": { "type": "string", "minLength": 1 }
            }
          },
          "else": {
            "properties": {
              "score": { "type": "null" },
              "statusLabel": { "type": "null" }
            }
          }
        }
      ]
    },
    "weather": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "condition", "temperatureC", "feelsLikeC", "humidityPercent", "pressureHpa", "visibilityKm", "windSpeedMps", "windGustMps", "windBearing", "cloudCoveragePercent", "uvIndex", "updatedAt", "climateLoad", "dailyForecast", "hourlyForecast"],
      "properties": {
        "available": { "type": "boolean" },
        "condition": { "type": ["string", "null"] },
        "temperatureC": { "type": ["number", "null"] },
        "feelsLikeC": { "type": ["number", "null"] },
        "humidityPercent": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "pressureHpa": { "type": ["number", "null"] },
        "visibilityKm": { "type": ["number", "null"], "minimum": 0 },
        "windSpeedMps": { "type": ["number", "null"], "minimum": 0 },
        "windGustMps": { "type": ["number", "null"], "minimum": 0 },
        "windBearing": { "type": ["number", "string", "null"] },
        "cloudCoveragePercent": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "uvIndex": { "type": ["number", "null"], "minimum": 0 },
        "updatedAt": { "type": ["string", "null"], "format": "date-time" },
        "climateLoad": {
          "type": "object",
          "additionalProperties": false,
          "required": ["level", "score", "factors"],
          "properties": {
            "level": { "enum": ["negligible", "weak", "strong", "unknown"] },
            "score": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
            "factors": {
              "type": "array",
              "maxItems": 8,
              "uniqueItems": true,
              "items": { "enum": ["temperature", "wind", "humidity", "sun", "precipitation"] }
            }
          }
        },
        "dailyForecast": { "type": "array", "maxItems": 10, "items": { "$ref": "#/$defs/weatherForecast" } },
        "hourlyForecast": { "type": "array", "maxItems": 24, "items": { "$ref": "#/$defs/weatherForecast" } }
      }
    },
    "weatherForecast": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "condition", "temperatureC", "lowTemperatureC", "feelsLikeC", "humidityPercent", "precipitationProbabilityPercent", "precipitationMm", "windSpeedMps", "windGustMps", "windBearing", "pressureHpa", "cloudCoveragePercent", "uvIndex"],
      "properties": {
        "at": { "type": "string", "format": "date-time" },
        "condition": { "type": ["string", "null"] },
        "temperatureC": { "type": ["number", "null"] },
        "lowTemperatureC": { "type": ["number", "null"] },
        "feelsLikeC": { "type": ["number", "null"] },
        "humidityPercent": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "precipitationProbabilityPercent": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "precipitationMm": { "type": ["number", "null"], "minimum": 0 },
        "windSpeedMps": { "type": ["number", "null"], "minimum": 0 },
        "windGustMps": { "type": ["number", "null"], "minimum": 0 },
        "windBearing": { "type": ["number", "string", "null"] },
        "pressureHpa": { "type": ["number", "null"] },
        "cloudCoveragePercent": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "uvIndex": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "room": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "icon": { "type": ["string", "null"] },
        "temp": { "type": ["number", "null"] },
        "humidity": { "type": ["number", "null"] },
        "targetTemp": { "type": ["number", "null"] },
        "targetHumidity": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "minTargetTemp": { "type": ["number", "null"] },
        "manualTarget": { "type": "boolean" },
        "manualControl": { "type": "boolean" },
        "targetStrategy": { "type": ["string", "null"] },
        "climateState": { "type": ["string", "null"] },
        "climateRunning": { "type": "boolean" },
        "hasClimateControl": { "type": "boolean" },
        "deviceIds": {
          "type": "array",
          "items": { "type": "string" }
        },
        "status": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "device": {
      "type": "object",
      "required": ["id", "name", "domain", "category", "state"],
      "properties": {
        "id": { "type": "string" },
        "entityId": { "type": ["string", "null"] },
        "physicalId": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "roomId": { "type": ["string", "null"] },
        "roomName": { "type": ["string", "null"] },
        "domain": { "type": "string" },
        "category": { "type": "string" },
        "icon": { "type": ["string", "null"] },
        "state": { "type": "string" },
        "reportedState": { "type": ["string", "null"] },
        "stateLabel": { "type": ["string", "null"] },
        "active": { "type": "boolean" },
        "unavailable": { "type": "boolean" },
        "tone": { "type": ["string", "null"] },
        "primaryValue": { "type": ["string", "null"] },
        "source": { "type": ["string", "null"] },
        "model": { "type": ["string", "null"] },
        "manufacturer": { "type": ["string", "null"] },
        "imageUrl": { "type": ["string", "null"] },
        "ageMin": { "type": ["integer", "null"], "minimum": 0 },
        "attributes": {
          "type": "object",
          "additionalProperties": true
        },
        "actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/action" }
        },
        "details": {
          "type": "array",
          "items": { "$ref": "#/$defs/deviceDetail" }
        },
        "energy": {
          "anyOf": [
            { "$ref": "#/$defs/energyMeasurements" },
            { "type": "null" }
          ]
        },
        "powerDependency": {
          "anyOf": [
            { "$ref": "#/$defs/powerDependency" },
            { "type": "null" }
          ]
        },
        "commandBlock": { "$ref": "#/$defs/commandBlock" }
      },
      "additionalProperties": true
    },
    "powerDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceDeviceId", "state", "reason", "blocksCommands"],
      "properties": {
        "sourceDeviceId": { "type": "string", "minLength": 1 },
        "state": { "enum": ["powered", "unpowered", "unavailable"] },
        "reason": {
          "enum": ["power_source_on", "power_source_off", "power_source_unavailable"]
        },
        "blocksCommands": { "type": "boolean" }
      }
    },
    "commandBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "recommendedAction"],
      "properties": {
        "code": {
          "enum": [
            "offline",
            "stale_evidence",
            "unsupported_action",
            "safety_policy",
            "conflict",
            "dependency_unavailable"
          ]
        },
        "message": { "type": "string", "minLength": 1, "maxLength": 160 },
        "recommendedAction": {
          "enum": ["retry", "refresh", "wait", "check_device", "review_settings"]
        }
      }
    },
    "inventory": {
      "type": "object",
      "required": ["summary", "devices"],
      "properties": {
        "summary": {
          "type": "object",
          "required": [
            "registeredCount",
            "canonicalDeviceCount",
            "physicalDeviceCount",
            "logicalEntityCount",
            "virtualCount",
            "unassignedCount",
            "unavailableCount",
            "emptyCount",
            "duplicateGroupCount",
            "attentionCount"
          ],
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "devices": {
          "type": "array",
          "items": { "$ref": "#/$defs/inventoryDevice" }
        }
      },
      "additionalProperties": true
    },
    "energyMeasurements": {
      "type": "object",
      "required": ["currentPowerW", "currentA", "voltageV", "totalKwh"],
      "properties": {
        "currentPowerW": { "type": ["number", "null"] },
        "currentA": { "type": ["number", "null"] },
        "voltageV": { "type": ["number", "null"] },
        "totalKwh": { "type": ["number", "null"] }
      },
      "additionalProperties": true
    },
    "energy": {
      "type": "object",
      "required": ["available", "currentPowerW", "currentA", "voltageV", "totalKwh", "sources", "selectedSourceIds", "settings"],
      "properties": {
        "available": { "type": "boolean" },
        "currentPowerW": { "type": ["number", "null"] },
        "currentA": { "type": ["number", "null"] },
        "voltageV": { "type": ["number", "null"] },
        "totalKwh": { "type": ["number", "null"] },
        "sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/energySource" }
        },
        "selectedSourceIds": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "settings": { "$ref": "#/$defs/energySettings" }
      },
      "additionalProperties": false
    },
    "energySource": {
      "allOf": [
        { "$ref": "#/$defs/energyMeasurements" },
        {
          "type": "object",
          "required": ["id", "deviceId", "name", "available"],
          "properties": {
            "id": { "type": "string" },
            "deviceId": { "type": "string" },
            "name": { "type": "string" },
            "roomId": { "type": ["string", "null"] },
            "roomName": { "type": ["string", "null"] },
            "available": { "type": "boolean" }
          }
        }
      ]
    },
    "energySettings": {
      "type": "object",
      "required": ["displayUnits", "showVoltage", "aggregation", "useAllDevices"],
      "properties": {
        "displayUnits": { "enum": ["watts", "amps", "both"] },
        "showVoltage": { "type": "boolean" },
        "aggregation": { "enum": ["combined", "separate"] },
        "useAllDevices": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "inventoryDevice": {
      "type": "object",
      "required": [
        "id",
        "canonicalId",
        "name",
        "kind",
        "status",
        "canonical",
        "possibleDuplicate",
        "entityCount",
        "domains",
        "integrations",
        "disabled"
      ],
      "properties": {
        "id": { "type": "string" },
        "canonicalId": { "type": "string" },
        "name": { "type": "string" },
        "roomId": { "type": ["string", "null"] },
        "roomName": { "type": ["string", "null"] },
        "kind": { "enum": ["physical", "virtual", "entity_only"] },
        "status": { "enum": ["available", "unavailable", "empty", "disabled"] },
        "canonical": { "type": "boolean" },
        "possibleDuplicate": { "type": "boolean" },
        "duplicateOf": { "type": ["string", "null"] },
        "entityCount": { "type": "integer", "minimum": 0 },
        "domains": {
          "type": "array",
          "items": { "type": "string" }
        },
        "model": { "type": ["string", "null"] },
        "manufacturer": { "type": ["string", "null"] },
        "imageUrl": { "type": ["string", "null"] },
        "integrations": {
          "type": "array",
          "items": { "type": "string" }
        },
        "disabled": { "type": "boolean" },
        "reason": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "scenario": {
      "type": "object",
      "required": ["id", "title"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "group": { "type": ["string", "null"] },
        "description": { "type": ["string", "null"] },
        "icon": { "type": ["string", "null"] },
        "requiresConfirmation": { "type": "boolean" },
        "favorite": { "type": "boolean" },
        "danger": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "alarm": {
      "type": "object",
      "required": ["id", "title", "level", "active"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": ["string", "null"] },
        "level": { "enum": ["info", "warn", "bad"] },
        "active": { "type": "boolean" },
        "roomId": { "type": ["string", "null"] },
        "entityId": { "type": ["string", "null"] },
        "ts": { "type": ["integer", "null"] }
      },
      "additionalProperties": true
    },
    "event": {
      "type": "object",
      "required": ["id", "ts", "title"],
      "properties": {
        "id": { "type": "string" },
        "ts": { "type": "integer" },
        "title": { "type": "string" },
        "message": { "type": ["string", "null"] },
        "roomId": { "type": ["string", "null"] },
        "entityId": { "type": ["string", "null"] },
        "kind": { "type": ["string", "null"] },
        "level": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "action": {
      "type": "object",
      "required": ["id", "title"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "confirmation": { "type": "boolean" },
        "payload": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "deviceDetail": {
      "type": "object",
      "required": ["label", "value"],
      "properties": {
        "label": { "type": "string" },
        "value": { "type": "string" },
        "entityId": { "type": ["string", "null"] },
        "domain": { "type": ["string", "null"] },
        "state": { "type": ["string", "null"] },
        "control": {
          "anyOf": [
            { "$ref": "#/$defs/deviceRangeControl" },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": false
    },
    "deviceRangeControl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "minimum", "maximum", "step", "targetId", "actionId"],
      "properties": {
        "kind": { "const": "range" },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "step": { "type": "number", "exclusiveMinimum": 0 },
        "unit": { "type": ["string", "null"], "maxLength": 32 },
        "targetId": { "type": "string", "pattern": "^entity_[0-9a-f]{16}$" },
        "actionId": { "const": "set_value" }
      }
    }
  },
  "additionalProperties": true
}

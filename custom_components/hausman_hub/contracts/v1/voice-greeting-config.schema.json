{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hausman.local/hausmanhub/contracts/v1/voice-greeting-config.schema.json",
  "title": "HausmanHub voice greeting config v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "revision", "updatedAt", "settings"],
  "properties": {
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "hausman-hub-voice-greeting-config" },
        "version": { "const": 1 }
      }
    },
    "revision": { "type": "integer", "minimum": 0 },
    "updatedAt": { "type": "string", "format": "date-time" },
    "settings": { "$ref": "#/$defs/settings" }
  },
  "$defs": {
    "summaryItem": {
      "enum": ["temperature", "humidity", "air_quality", "security"]
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "stationEntityId",
        "delaySeconds",
        "greetingText",
        "summaryItems",
        "followUpEnabled",
        "followUpText",
        "homeQuestionsEnabled"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "stationEntityId": {
          "type": "string",
          "pattern": "^media_player\\.[a-z0-9_]+$",
          "maxLength": 128
        },
        "delaySeconds": { "type": "integer", "minimum": 0, "maximum": 60 },
        "greetingText": { "type": "string", "minLength": 1, "maxLength": 180 },
        "summaryItems": {
          "type": "array",
          "items": { "$ref": "#/$defs/summaryItem" },
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true
        },
        "followUpEnabled": { "type": "boolean" },
        "followUpText": { "type": "string", "minLength": 1, "maxLength": 180 },
        "homeQuestionsEnabled": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "followUpEnabled": { "const": true } } },
          "then": { "properties": { "homeQuestionsEnabled": { "const": true } } }
        }
      ]
    }
  }
}

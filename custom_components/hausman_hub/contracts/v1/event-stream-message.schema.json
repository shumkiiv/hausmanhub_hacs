{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hausman.local/hausmanhub/contracts/v1/event-stream-message.schema.json",
  "title": "HausmanHub server-sent event message v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "id", "type", "occurred_at", "data"],
  "properties": {
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "hausman-hub-event" },
        "version": { "const": 1 }
      }
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "type": {
      "enum": [
        "hello",
        "snapshot_invalidated",
        "critical_alert",
        "attention_alert",
        "command_receipt",
        "heartbeat"
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "oneOf": [
        { "$ref": "#/$defs/hello" },
        { "$ref": "#/$defs/snapshot_invalidated" },
        { "$ref": "#/$defs/critical_alert" },
        { "$ref": "#/$defs/attention_alert" },
        { "$ref": "#/$defs/command_receipt" },
        { "$ref": "#/$defs/heartbeat" }
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "hello" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/hello" } } }
    },
    {
      "if": { "properties": { "type": { "const": "snapshot_invalidated" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/snapshot_invalidated" } } }
    },
    {
      "if": { "properties": { "type": { "const": "critical_alert" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/critical_alert" } } }
    },
    {
      "if": { "properties": { "type": { "const": "attention_alert" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/attention_alert" } } }
    },
    {
      "if": { "properties": { "type": { "const": "command_receipt" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/command_receipt" } } }
    },
    {
      "if": { "properties": { "type": { "const": "heartbeat" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/heartbeat" } } }
    }
  ],
  "$defs": {
    "hello": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api_major_version", "heartbeat_seconds"],
      "properties": {
        "api_major_version": { "const": 1 },
        "heartbeat_seconds": { "type": "integer", "minimum": 5, "maximum": 120 }
      }
    },
    "snapshot_invalidated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason"],
      "properties": {
        "reason": {
          "enum": ["state_changed", "registry_changed", "scenario_changed", "settings_changed"]
        },
        "state_revision": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "critical_alert": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alert_id", "kind", "severity", "title", "message", "active"],
      "properties": {
        "alert_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "kind": { "enum": ["leak", "smoke", "gas", "security", "other"] },
        "severity": { "enum": ["warning", "critical"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "message": { "type": "string", "minLength": 1, "maxLength": 500 },
        "room": { "type": ["string", "null"], "maxLength": 120 },
        "device": { "type": ["string", "null"], "maxLength": 120 },
        "active": { "type": "boolean" }
      }
    },
    "attention_alert": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alert_id", "kind", "severity", "title", "message", "active"],
      "properties": {
        "alert_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "kind": { "enum": ["low_battery", "device_unavailable", "maintenance", "other"] },
        "severity": { "enum": ["info", "warning"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "message": { "type": "string", "minLength": 1, "maxLength": 500 },
        "room": { "type": ["string", "null"], "maxLength": 120 },
        "device": { "type": ["string", "null"], "maxLength": 120 },
        "value": { "type": ["number", "null"] },
        "unit": { "type": ["string", "null"], "maxLength": 20 },
        "active": { "type": "boolean" }
      }
    },
    "command_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "operation", "accepted", "confirmed", "status"],
      "properties": {
        "request_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "operation": { "type": "string", "minLength": 1, "maxLength": 128 },
        "accepted": { "type": "boolean" },
        "confirmed": { "type": "boolean" },
        "status": { "enum": ["failed", "accepted", "confirmed"] },
        "target_id": { "type": ["string", "null"], "maxLength": 128 },
        "reason": { "type": ["string", "null"], "maxLength": 500 },
        "error_code": { "type": ["string", "null"], "maxLength": 128 },
        "queue": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "position", "transitions", "superseded_by_request_id"],
          "properties": {
            "state": {
              "enum": ["queued", "executing", "superseded", "completed"]
            },
            "position": { "type": "integer", "minimum": 0, "maximum": 256 },
            "transitions": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "enum": ["queued", "executing", "superseded", "completed"]
              }
            },
            "superseded_by_request_id": {
              "type": ["string", "null"],
              "minLength": 1,
              "maxLength": 128
            }
          }
        }
      }
    },
    "heartbeat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 0 }
      }
    }
  }
}

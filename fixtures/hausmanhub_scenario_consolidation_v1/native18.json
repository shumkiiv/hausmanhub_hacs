                      "text": "{% set ns = namespace(leaks=[], hazards=[], openings=[]) %} {% for item in states.binary_sensor %}\n  {% if item.state == 'on' and item.attributes.device_class == 'moisture' %}\n    {% set ns.leaks = ns.leaks + [(item.attributes.friendly_name | default(item.entity_id, true)) | replace(' Дверь', '') | replace(' Окно', '')] %}\n  {% elif item.state == 'on' and item.attributes.device_class in ['smoke', 'gas'] %}\n    {% set ns.hazards = ns.hazards + [(item.attributes.friendly_name | default(item.entity_id, true)) | replace(' Дверь', '') | replace(' Окно', '')] %}\n  {% elif item.state == 'on' and item.attributes.device_class in ['door', 'window', 'opening'] and 'шторк' not in (item.attributes.friendly_name | default('', true) | lower) and 'кондиционер' not in (item.attributes.friendly_name | default('', true) | lower) %}\n    {% set ns.openings = ns.openings + [(item.attributes.friendly_name | default(item.entity_id, true)) | replace(' Дверь', '') | replace(' Окно', '')] %}\n  {% endif %}\n{% endfor %} {% if ns.leaks | count == 0 and ns.hazards | count == 0 %}\n  Протечек, дыма и газа не обнаружено.\n{% else %}\n  Внимание.\n  {% if ns.leaks | count > 0 %}Протечка: {{ ns.leaks | join(', ') }}.{% endif %}\n  {% if ns.hazards | count > 0 %}Тревога: {{ ns.hazards | join(', ') }}.{% endif %}\n{% endif %} {% if ns.openings | count == 0 %}\n  Контролируемые двери и окна закрыты.\n{% else %}\n  Открыто: {{ ns.openings[:4] | join(', ') }}.\n{% endif %}",

      }
    },
    {
      "entity_id": "automation.hausman_dushevaia_golosovaia_trevoga_iandeks",
      "state": "on",
      "definition": {
        "id": "hausmanhub_shower_leak_yandex_alert",
        "alias": "Hausman: душевая - голосовая тревога Яндекс",
        "description": "При протечке от любого из трёх датчиков душевой перекрывает горячую и холодную воду, отправляет Telegram и сообщает о тревоге на доступных Яндекс Станциях. Планшет Hausman реагирует на состояние датчика напрямую.",
        "triggers": [
          {
            "trigger": "state",
            "entity_id": "binary_sensor.0x983268fffe63cb6c_water_leak",
            "to": "on"
          },
          {
            "trigger": "state",
            "entity_id": "binary_sensor.0x8c73dafffe292427_water_leak",
            "to": "on"
          },
          {
            "trigger": "state",
            "entity_id": "binary_sensor.0x8c73dafffec850cc_water_leak",
            "to": "on"
          }
        ],
        "conditions": [],
        "actions": [
          {
            "delay": "00:00:03"
          },
          {
            "condition": "template",
            "value_template": "{{ expand([\n  'binary_sensor.0x983268fffe63cb6c_water_leak',\n  'binary_sensor.0x8c73dafffe292427_water_leak',\n  'binary_sensor.0x8c73dafffec850cc_water_leak'\n]) | selectattr('state', 'eq', 'on') | list | count > 0 }}"
          },
          {
            "parallel": [
              {
                "sequence": [
                  {
                    "action": "switch.turn_off",
                    "continue_on_error": true,
                    "target": {
                      "entity_id": "switch.0x54ef441001301a68"
                    }
                  }
                ]
              },
              {
                "sequence": [
                  {
                    "action": "switch.turn_off",
                    "continue_on_error": true,
                    "target": {
                      "entity_id": "switch.0x54ef44100130084b"
                    }
                  }
                ]
              },
              {
                "sequence": [
                  {
                    "action": "tts.yandex_station_say",
                    "continue_on_error": true,
                    "data": {
                      "entity_id": [
                        "media_player.yandex_station_lp0000000000006605730000f6075695",
                        "media_player.yandex_station_m00h89900gxvxk",
                        "media_player.yandex_station_l01a0wg002dabn",
                        "media_player.yandex_station_l01rd8k009sw4b",
                        "media_player.yandex_station_l00690e0047jpp",
                        "media_player.yandex_station_x00jqh000p7nqb"
                      ],
                      "message": "{% set active = expand([\n  'binary_sensor.0x983268fffe63cb6c_water_leak',\n  'binary_sensor.0x8c73dafffe292427_water_leak',\n  'binary_sensor.0x8c73dafffec850cc_water_leak'\n]) | selectattr('state', 'eq', 'on')\n   | map(attribute='attributes.friendly_name') | list %}\nВнимание. Обнаружена протечка в душевой. {{ active | join(', ') }}. Вода перекрывается автоматически."
                    }
                  }
                ]
              }
            ]
          },
          {
            "wait_template": "{{ is_state('switch.0x54ef441001301a68', 'off') and\n   is_state('switch.0x54ef44100130084b', 'off') }}",
            "timeout": "00:00:15",
            "continue_on_timeout": true
          },
          {
            "if": [
              {
                "condition": "template",
                "value_template": "{{ not (is_state('switch.0x54ef441001301a68', 'off') and\n        is_state('switch.0x54ef44100130084b', 'off')) }}"
              }
            ],
            "then": [
              {
                "action": "tts.yandex_station_say",
                "continue_on_error": true,
                "data": {
                  "entity_id": [
                    "media_player.yandex_station_lp0000000000006605730000f6075695",
                    "media_player.yandex_station_m00h89900gxvxk",
                    "media_player.yandex_station_l01a0wg002dabn",
                    "media_player.yandex_station_l01rd8k009sw4b",
                    "media_player.yandex_station_l00690e0047jpp",
                    "media_player.yandex_station_x00jqh000p7nqb"
                  ],
                  "message": "Внимание. Не удалось подтвердить перекрытие воды после протечки в душевой. Перекройте горячую и холодную воду вручную."
                }
              }
            ]
          }
        ],
        "mode": "queued",
        "max": 3
      }
    },
    {
      "entity_id": "automation.hausmanhub_dialog_alisy_cherez_assist",
      "state": "off",
      "definition": {
        "id": "hausmanhub_yandex_dialog_conversation",
        "alias": "HausmanHub: диалог Алисы через Assist",
        "description": "Передает запросы приватного навыка Хаусман Хаб в Home Assistant Conversation API",
        "trigger": [
          {
            "platform": "event",
            "event_type": "yandex_intent"
          }
        ],
        "condition": [],
        "action": [
          {
            "variables": {
              "request_text": "{{ trigger.event.data.text | default('', true) | lower }}",
              "room_key": "{% if 'гостин' in request_text %}living {% elif 'кухн' in request_text %}kitchen {% elif 'детск' in request_text %}kids {% elif 'спальн' in request_text %}bedroom {% elif 'ванн' in request_text %}bathroom {% elif 'туалет' in request_text %}toilet {% elif 'прихож' in request_text %}hallway {% else %}none{% endif %}",
              "room_phrase": "{% if room_key == 'living' %}в гостиной {% elif room_key == 'kitchen' %}на кухне {% elif room_key == 'kids' %}в детской {% elif room_key == 'bedroom' %}в спальне {% elif room_key == 'bathroom' %}в ванной {% elif room_key == 'toilet' %}в туалете {% elif room_key == 'hallway' %}в прихожей {% else %}в доме{% endif %}",
              "temperature_entity": "{% if room_key == 'living' %}sensor.0xa4c138999277e5ea_temperature {% elif room_key == 'kitchen' %}sensor.0xa4c138802a9dc76e_temperature {% elif room_key == 'kids' %}sensor.0xa4c1389ecebec375_temperature {% else %}{% endif %}",
              "humidity_entity": "{% if room_key == 'living' %}sensor.0xa4c138999277e5ea_humidity {% elif room_key == 'kitchen' %}sensor.0xa4c138802a9dc76e_humidity {% elif room_key == 'kids' %}sensor.0xa4c1389ecebec375_humidity {% else %}{% endif %}",
              "co2_value": "{{ states('sensor.0xa4c138ccc1c6de73_co2') | int(0) }}",

            }
          },
          {
            "action": "switch.turn_off",
            "target": {
              "entity_id": [
                "switch.0x603d61fffe761c63_1",
                "switch.0xa4c138ffecbc07b5_l1"
              ]
            }
          }
        ],
        "mode": "restart",
        "max_exceeded": "silent"
      }
    },
    {

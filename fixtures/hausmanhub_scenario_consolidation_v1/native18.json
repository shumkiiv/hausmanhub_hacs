                      "text": "{% set ns = namespace(items=[]) %} {% for item in states.sensor %}\n  {% if item.attributes.device_class == 'battery'\n        and item.state not in ['unknown', 'unavailable']\n        and item.state | float(100) < 8 %}\n    {% set ns.items = ns.items + [(item.attributes.friendly_name | default(item.entity_id, true)) ~ ' ' ~ item.state ~ '%'] %}\n  {% endif %}\n{% endfor %} {% if ns.items | count == 0 %}\n  Устройств с зарядом ниже восьми процентов нет.\n{% else %}\n  Критически низкий заряд: {{ ns.items[:5] | join(', ') }}.\n  {% if ns.items | count > 5 %}И ещё {{ ns.items | count - 5 }}.{% endif %}\n{% endif %}",
                      "end_session": false
                    }
                  }
                ]
              },
              {
                "conditions": "{{ 'безопасност' in request_text or 'всё ли спокойно' in request_text or 'все ли спокойно' in request_text }}",

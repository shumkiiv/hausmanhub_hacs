    {
      "entity_id": "automation.dushevaia_vykliuchit_vytiazhku_pri_otsutstvii_i_normalnoi_vlazhnosti",
      "state": "on",
      "definition": {
        "id": "hausman_shower_fan_off_absence_normal_humidity",
        "alias": "Душевая: выключить вытяжку при отсутствии и нормальной влажности",
        "description": "Выключает вытяжку, когда человека нет и влажность не выше 55% непрерывно 5 минут.",
        "triggers": [
          {
            "platform": "template",
            "value_template": "{{ is_state(\"binary_sensor.0xf044d3fffe1a2303_occupancy\", \"off\") and states(\"sensor.0xa4c138f42365236e_humidity\") | float(999) <= 55 }}",
            "for": "00:05:00"

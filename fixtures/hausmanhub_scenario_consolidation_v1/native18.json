    },
    {
      "entity_id": "automation.dushevaia_vkliuchit_vytiazhku_po_vysokoi_vlazhnosti",
      "state": "on",
      "definition": {
        "id": "hausman_shower_fan_humidity_on_failsafe",
        "alias": "Душевая: включить вытяжку по высокой влажности",
        "description": "Включает вытяжку при влажности выше 55%, даже если человека уже нет.",
        "triggers": [
          {
            "platform": "numeric_state",
            "entity_id": "sensor.0xa4c138f42365236e_humidity",

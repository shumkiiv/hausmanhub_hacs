                    "event_data": {
                      "text": "В гостиной {{ states('sensor.0xa4c138999277e5ea_temperature') | replace('.', ',') }} градуса, на кухне {{ states('sensor.0xa4c138802a9dc76e_temperature') | replace('.', ',') }} градуса, в детской {{ states('sensor.0xa4c1389ecebec375_temperature') | replace('.', ',') }} градуса.",
                      "end_session": false
                    }
                  }
                ]
              },
              {
                "conditions": "{{ 'влажност' in request_text and room_key == 'none' }}",
                "sequence": [
                  {
                    "event": "yandex_intent_response",
                    "event_data": {
                      "text": "В гостиной влажность {{ states('sensor.0xa4c138999277e5ea_humidity') }}%, на кухне {{ states('sensor.0xa4c138802a9dc76e_humidity') }}%, в детской {{ states('sensor.0xa4c1389ecebec375_humidity') }}%.",
                      "end_session": false
                    }

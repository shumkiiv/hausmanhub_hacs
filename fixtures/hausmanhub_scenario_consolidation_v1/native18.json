        "mode": "queued",
        "max": 5
      }
    },
    {
      "entity_id": "automation.hausmanhub_privetstvie_pri_vozvrashchenii_domoi",
      "state": "off",
      "definition": {
        "id": "hausmanhub_yandex_welcome_home",
        "alias": "HausmanHub: приветствие при возвращении домой",
        "description": "Через три секунды после снятия режима Никого нет дома запускает приватный навык на Станции Мини в гостиной",
        "trigger": [
          {
            "platform": "state",
            "entity_id": "input_boolean.away_from_home",
            "from": "on",
            "to": "off"
          }
        ],
        "condition": [
          {
            "condition": "template",
            "value_template": "{{ states('media_player.yandex_station_m00h89900gxvxk') not in ['unknown', 'unavailable'] }}"
          }
        ],
        "action": [
          {
            "delay": "00:00:03"
          },
          {
            "condition": "state",
            "entity_id": "input_boolean.away_from_home",
            "state": "off"
          },
          {
            "service": "yandex_station.send_command",
            "target": {
              "entity_id": "media_player.yandex_station_m00h89900gxvxk"
            },
            "data": {
              "text": "попроси Хаусман Хаб приветствие при возвращении домой"
            }
          }
        ],
        "mode": "restart"
      }
    }
  ]

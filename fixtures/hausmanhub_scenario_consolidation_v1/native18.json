                  {
                    "event": "yandex_intent_response",
                    "event_data": {
                      "text": "{% set ns = namespace(items=[]) %} {% for item in states.binary_sensor %}\n  {% if item.attributes.device_class in ['door', 'window', 'opening'] and item.state == 'on' and 'шторк' not in (item.attributes.friendly_name | default('', true) | lower) and 'кондиционер' not in (item.attributes.friendly_name | default('', true) | lower) %}\n    {% set ns.items = ns.items + [(item.attributes.friendly_name | default(item.entity_id, true)) | replace(' Дверь', '') | replace(' Окно', '')] %}\n  {% endif %}\n{% endfor %} {% if ns.items | count == 0 %}\n  Все контролируемые двери и окна закрыты.\n{% else %}\n  Сейчас открыто: {{ ns.items[:5] | join(', ') }}.\n  {% if ns.items | count > 5 %}И ещё {{ ns.items | count - 5 }}.{% endif %}\n{% endif %}",
                      "end_session": false
                    }
                  }
                ]
              },

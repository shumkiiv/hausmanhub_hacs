      "state": "on",
      "definition": {
        "id": "hausman_shower_cabinet_off_absence_failsafe",
        "alias": "Душевая: выключить подсветку шкафа при отсутствии",
        "description": "Страховочное выключение подсветки шкафа после 5 минут устойчивого отсутствия, независимо от обновлений влажности.",
        "triggers": [

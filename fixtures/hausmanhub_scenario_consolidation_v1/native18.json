    {
      "entity_id": "automation.malyi_koridor_nochiu_vykliuchit_svet_cherez_3_minuty_otsutstviia",
      "state": "on",
      "definition": {
        "id": "hausman_night_absence_small_corridor_light_off",
        "alias": "Малый коридор: ночью выключить свет через 3 минуты отсутствия",
        "description": "После 23:00 и до рассвета выключает люстру и её питание, если движение отсутствует 3 минуты.",
        "triggers": [
          {
            "platform": "template",
            "value_template": "{{ ((now().hour >= 23) or (now().hour < 12 and is_state(\"sun.sun\", \"below_horizon\"))) and is_state(\"binary_sensor.0xf044d3fffebaf11b_occupancy\", \"off\") }}",
            "for": "00:03:00"
          }
        ],
        "conditions": [],
        "actions": [
          {
            "action": "light.turn_off",
            "target": {
              "entity_id": "light.0xa4c138d69d102803"
            }
          },
          {
            "action": "switch.turn_off",
            "target": {
              "entity_id": "switch.0x603d61fffe75c334_1"
            }
          }
        ],
        "mode": "restart",
        "max_exceeded": "silent"
      }
    },
    {
      "entity_id": "automation.tambur_nochiu_vykliuchit_svet_cherez_3_minuty_otsutstviia",
      "state": "on",
      "definition": {
        "id": "hausman_night_absence_tambur_light_off",
        "alias": "Тамбур: ночью выключить свет через 3 минуты отсутствия",
        "description": "После 23:00 и до рассвета выключает люстру, точки и зеркало, если датчики присутствия и движения устойчиво не видят человека 3 минуты.",
        "triggers": [
          {
            "platform": "template",
            "value_template": "{{ ((now().hour >= 23) or (now().hour < 12 and is_state(\"sun.sun\", \"below_horizon\"))) and is_state(\"binary_sensor.0xf044d3fffe0160c0_occupancy\", \"off\") and is_state(\"binary_sensor.0xf044d3fffe11964d_occupancy\", \"off\") }}",
            "for": "00:03:00"
          }
        ],
        "conditions": [],
        "actions": [
          {
            "action": "light.turn_off",
            "target": {

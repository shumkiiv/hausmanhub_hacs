{
  "contract": {
    "name": "hausman-hub-capabilities",
    "version": 1
  },
  "api": {
    "major_version": 1,
    "base_path": "/api/hausman_hub/v1"
  },
  "capabilities": {
    "device_actions": {
      "available": true,
      "path": "/api/hausman_hub/v1/device-actions",
      "method": "POST",
      "requires_confirmation": false,
      "receipt_read_back": true,
      "request_contract": {
        "name": "hausman-hub-device-action-request",
        "version": 1
      },
      "response_contract": {
        "name": "hausman-hub-device-action-receipt",
        "version": 1
      },
      "feature_matrix_path": "/api/hausman_hub/v1/device-features",
      "feature_matrix_method": "GET",
      "feature_matrix_contract": {
        "name": "hausman-hub-device-feature-matrix",
        "version": 1
      },
      "batch_path": "/api/hausman_hub/v1/device-actions/batch",
      "batch_method": "POST",
      "batch_request_contract": {
        "name": "hausman-hub-device-action-batch-request",
        "version": 1
      },
      "batch_response_contract": {
        "name": "hausman-hub-device-action-batch-receipt",
        "version": 1
      },
      "intercom_safety": {
        "confirmation_field": "confirmedByUser",
        "dry_run_field": "dryRun",
        "default_hold_seconds": 15,
        "maximum_hold_seconds": 20,
        "release_receipt_contract": {
          "name": "hausman-hub-intercom-release-receipt",
          "version": 1
        }
      }
    },
    "dashboard_snapshot": {
      "available": true,
      "path": "/api/hausman_hub/v1/dashboard",
      "method": "GET",
      "response_contract": {
        "name": "universal-home",
        "version": 1
      },
      "read_only": true
    },
    "climate_home": {
      "available": true,
      "path": "/api/hausman_hub/v1/home",
      "method": "GET",
      "response_contract": {
        "name": "hausman-hub-home",
        "version": 12
      }
    },
    "automatic_contours": {
      "available": true,
      "path": "/api/hausman_hub/v1/contours",
      "method": "GET",
      "response_contract": {
        "name": "hausman-hub-contours",
        "version": 7
      }
    },
    "contour_settings_apply": {
      "available": true,
      "preview_path": "/api/hausman_hub/v1/contours/apply-preview",
      "path": "/api/hausman_hub/v1/contours/apply",
      "method": "POST",
      "requires_confirmation": true,
      "request_contract": {
        "name": "hausman-hub-contour-apply-request",
        "version": 1
      },
      "response_contract": {
        "name": "hausman-hub-climate-control-receipt",
        "version": 1
      }
    },
    "temporary_room_temperature": {
      "available": true,
      "path": "/api/hausman_hub/v1/contours/temporary-temperature",
      "method": "POST",
      "requires_confirmation": true,
      "request_contract": {
        "name": "hausman-hub-temporary-temperature-request",
        "version": 1
      },
      "response_contract": {
        "name": "hausman-hub-climate-control-receipt",
        "version": 1
      }
    },
    "home_climate_targets": {
      "available": true,
      "path": "/api/hausman_hub/v1/contours/home-targets",
      "method": "POST",
      "requires_confirmation": true,
      "request_contract": {
        "name": "hausman-hub-home-climate-targets-request",
        "version": 1
      },
      "response_contract": {
        "name": "hausman-hub-climate-control-receipt",
        "version": 1
      }
    },
    "climate_runtime": {
      "available": false,
      "phase": "unavailable",
      "commands_enabled": false,
      "read_path": "/api/hausman_hub/v1/climate/runtime",
      "action_path": "/api/hausman_hub/v1/climate/actions",
      "operation_path_template": "/api/hausman_hub/v1/climate/operations/{operation_id}",
      "read_method": "GET",
      "action_method": "POST",
      "operation_method": "GET",
      "durable_idempotency": true,
      "receipt_events": true,
      "read_contract": {
        "name": "hausman-hub-climate-runtime",
        "version": 1
      },
      "request_contract": {
        "name": "hausman-hub-climate-action-request",
        "version": 1
      },
      "receipt_contract": {
        "name": "hausman-hub-climate-operation",
        "version": 1
      }
    },
    "tablet_profile": {
      "available": true,
      "path": "/api/hausman_hub/v1/tablet-profile",
      "methods": [
        "GET",
        "PUT"
      ],
      "optimistic_locking": true,
      "response_contract": {
        "name": "hausman-hub-tablet-profile",
        "version": 1
      }
    },
    "tablet_power": {
      "available": true,
      "path": "/api/hausman_hub/v1/tablet-power-status",
      "method": "POST",
      "request_contract": {
        "name": "hausman-hub-tablet-power-status-request",
        "version": 1
      },
      "response_contract": {
        "name": "hausman-hub-tablet-power-status-receipt",
        "version": 1
      }
    },
    "room_settings": {
      "available": true,
      "path": "/api/hausman_hub/v1/room-settings",
      "methods": [
        "GET",
        "PUT"
      ],
      "optimistic_locking": true,
      "response_contract": {
        "name": "hausman-hub-room-settings",
        "version": 1
      }
    },
    "energy_settings": {
      "available": true,
      "path": "/api/hausman_hub/v1/energy-settings",
      "methods": [
        "GET",
        "PUT"
      ],
      "optimistic_locking": true,
      "response_contract": {
        "name": "hausman-hub-energy-settings",
        "version": 1
      }
    },
    "energy_history": {
      "available": true,
      "path": "/api/hausman_hub/v1/energy/history",
      "method": "GET",
      "read_only": true,
      "response_contract": {
        "name": "hausman-hub-energy-history",
        "version": 1
      }
    },
    "energy_meter": {
      "available": true,
      "path": "/api/hausman_hub/v1/energy/meter",
      "methods": [
        "GET",
        "POST"
      ],
      "optimistic_locking": true,
      "response_contract": {
        "name": "hausman-hub-energy-meter",
        "version": 1
      },
      "collection_path": "/api/hausman_hub/v1/energy/meters",
      "collection_methods": [
        "GET",
        "POST"
      ],
      "collection_response_contract": {
        "name": "hausman-hub-energy-meters",
        "version": 1
      }
    },
    "device_discovery": {
      "available": true,
      "path": "/api/hausman_hub/v1/device-discovery",
      "methods": [
        "GET",
        "POST"
      ],
      "optimistic_locking": true,
      "response_contract": {
        "name": "hausman-hub-device-discovery",
        "version": 1
      }
    },
    "event_stream": {
      "available": true,
      "path": "/api/hausman_hub/v1/events",
      "method": "GET",
      "transport": "text/event-stream",
      "response_contract": {
        "name": "hausman-hub-event",
        "version": 1
      },
      "heartbeat_seconds": 30,
      "resume": {
        "strategy": "last_event_id",
        "request_header": "Last-Event-ID",
        "max_events": 128,
        "delivery_queue_limit": 32,
        "survives_restart": false
      }
    },
    "scenarios": {
      "available": true,
      "read": true,
      "write": true,
      "test": true,
      "delete": true,
      "run": true,
      "aiDraft": {
        "available": false,
        "path": "/api/hausman_hub/v1/scenarios/ai-draft",
        "method": "POST",
        "request_contract": {"name": "hausman-hub-scenario-ai-draft-request", "version": 1},
        "response_contract": {"name": "hausman-hub-scenario-ai-draft", "version": 1},
        "saves": false,
        "sends_commands": false
      },
      "nodeRed": {
        "available": true,
        "statusPath": "/api/hausman_hub/v1/scenarios/node-red",
        "statusMethod": "GET",
        "sourcePathTemplate": "/api/hausman_hub/v1/scenarios/node-red/source/{scenario_id}",
        "sourceReadMethod": "GET",
        "sourceWriteMethod": "PUT",
        "source_contract": {"name": "hausman-hub-scenario-node-red-source", "version": 1},
        "source_update_request_contract": {"name": "hausman-hub-scenario-node-red-source-update-request", "version": 1},
        "source_update_receipt_contract": {"name": "hausman-hub-scenario-node-red-source-update-receipt", "version": 1},
        "maxSourceBytes": 65536,
        "optimisticLocking": true,
        "dryRunBeforeSave": true,
        "executionBackends": ["hausman", "node_red"],
        "physicalCommandsOwnedByHausman": true,
        "managedFlowStyle": "function"
      },
      "upcoming": true,
      "definitionVersions": [
        1
      ],
      "paths": {
        "list": "/api/hausman_hub/v1/scenarios",
        "catalog": "/api/hausman_hub/v1/scenarios/catalog",
        "health": "/api/hausman_hub/v1/scenarios/health",
        "test": "/api/hausman_hub/v1/scenarios/test",
        "delete": "/api/hausman_hub/v1/scenarios/delete",
        "run": "/api/hausman_hub/v1/scenarios/run",
        "action": "/api/hausman_hub/v1/scenarios/action",
        "aiDraft": "/api/hausman_hub/v1/scenarios/ai-draft",
        "nodeRedStatus": "/api/hausman_hub/v1/scenarios/node-red",
        "nodeRedSourceTemplate": "/api/hausman_hub/v1/scenarios/node-red/source/{scenario_id}",
        "upcoming": "/api/hausman_hub/v1/scenarios/upcoming",
        "upcomingCancel": "/api/hausman_hub/v1/scenarios/upcoming/cancel"
      }
    },
    "voice_greeting": {
      "available": false,
      "provider": "alexxit_yandex_station",
      "dialogSupported": false,
      "path": "/api/hausman_hub/v1/voice/yandex-greeting",
      "methods": [
        "GET",
        "PUT"
      ],
      "testPath": "/api/hausman_hub/v1/voice/yandex-greeting/test",
      "testMethod": "POST",
      "optimistic_locking": true,
      "response_contract": {
        "name": "hausman-hub-voice-greeting-config",
        "version": 1
      },
      "test_request_contract": {
        "name": "hausman-hub-voice-greeting-test-request",
        "version": 1
      },
      "test_receipt_contract": {
        "name": "hausman-hub-voice-command-receipt",
        "version": 1
      },
      "stations": []
    }
  }
}
